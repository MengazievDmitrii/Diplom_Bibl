<!-- STAGE 3 FIX: Исправлен XAML (убраны дублирующиеся Content) -->
<Page x:Class="Diplom_Bibl.Pages.ComputerSessionsManagement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление ПК" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="ActiveSessionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="💻 Управление компьютерами" 
                   Style="{StaticResource SectionTitleStyle}" FontSize="24"/>

        <!-- Статистика -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Padding="15" Margin="0,0,0,20"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🖥️ Активных ПК: " FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActiveComputersCount" Text="0" FontSize="14" FontWeight="Bold" 
                               Foreground="{StaticResource SuccessColor}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="👥 Всего сессий сегодня: " FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalSessionsToday" Text="0" FontSize="14" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="⏱️ Среднее время: " FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AvgDuration" Text="0 мин" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Вкладки -->
        <TabControl Grid.Row="2">
            <!-- Активные сессии -->
            <TabItem Header="🟢 Активные сессии">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <StackPanel>
                        <ItemsControl x:Name="ActiveSessionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ActiveSessionStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Информация -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock FontSize="16" FontWeight="Bold">
                                                    <Run Text="🖥️ "/><Run Text="{Binding ComputerNumber}"/>
                                                    <Run Text=" — "/><Run Text="{Binding FullName}"/>
                                                </TextBlock>
                                                <WrapPanel Margin="0,5,0,5">
                                                    <TextBlock Text="Группа: " Foreground="Gray"/>
                                                    <TextBlock Text="{Binding GroupCode}" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="Начало: " Foreground="Gray"/>
                                                    <TextBlock Text="{Binding StartTimeDisplay}" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                                    <TextBlock Text="Длительность: " Foreground="Gray"/>
                                                    <TextBlock Text="{Binding CurrentDuration}" FontWeight="SemiBold" 
                                                               Foreground="{StaticResource PrimaryColor}"/>
                                                </WrapPanel>
                                                <TextBlock TextWrapping="Wrap">
                                                    <Run Text="Цель: " Foreground="Gray"/>
                                                    <Run Text="{Binding Purpose}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Кнопки -->
                                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                                <Button Content="⏹️ Завершить" Width="120" Height="35"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        Click="ForceEndSession_Click"
                                                        Tag="{Binding ID_Session}"
                                                        ToolTip="Принудительное завершение сессии"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoActiveSessionsLabel" Text="Нет активных сессий" 
                                   FontSize="14" Foreground="Gray" HorizontalAlignment="Center"
                                   Margin="0,20,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- История сессий -->
            <TabItem Header="📋 История сессий">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Фильтры -->
                    <Border Grid.Row="0" Background="White" CornerRadius="6"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            Padding="10" Margin="0,0,0,15">
                        <WrapPanel>
                            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker x:Name="DateFrom" Width="120" Margin="0,0,10,0"
                                        SelectedDateChanged="DateFilter_Changed"/>
                            <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker x:Name="DateTo" Width="120" Margin="0,0,10,0"
                                        SelectedDateChanged="DateFilter_Changed"/>
                            <Button Content="🔍 Показать" Width="100" Height="30"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="RefreshHistory_Click"/>
                            <Button Content="📊 Экспорт" Width="100" Height="30"
                                    Style="{StaticResource SaveButtonStyle}"
                                    Margin="10,0,0,0"
                                    Click="ExportHistory_Click"/>
                        </WrapPanel>
                    </Border>

                    <!-- Таблица истории -->
                    <DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" RowHeight="35"
                              AlternatingRowBackground="{StaticResource LightGray}"
                              Background="White" BorderBrush="{StaticResource BorderColor}"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ПК" Binding="{Binding ComputerNumber}" Width="80"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="180"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupCode}" Width="100"/>
                            <DataGridTextColumn Header="Цель" Binding="{Binding Purpose}" Width="200"/>
                            <DataGridTextColumn Header="Начало" Binding="{Binding StartTimeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Конец" Binding="{Binding EndTimeDisplay}" Width="130"/>
                            <DataGridTextColumn Header="Длительность" Binding="{Binding DurationDisplay}" Width="100"/>
                            <DataGridTemplateColumn Header="Статус" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="5,2"
                                                Background="{Binding StatusColor}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="White"
                                                       FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>