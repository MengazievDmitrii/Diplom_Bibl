<Page x:Class="Diplom_Bibl.Pages.AddPost"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddPost" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка - форма добавления/редактирования -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Добавление должности" 
                       Style="{StaticResource SectionTitleStyle}"/>

            <Border Background="White" 
                    Padding="20" 
                    CornerRadius="8" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1"
                    Effect="{StaticResource DropShadowEffect}">

                <StackPanel>
                    <!-- Название должности -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Название должности:" 
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="PostNameTb" 
                                 Style="{StaticResource InputFieldStyle}"
                                 MaxLength="150"/>
                    </StackPanel>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="SaveNewButton" 
                                Content="➕ Добавить" 
                                Style="{StaticResource SaveButtonStyle}"
                                Width="120"
                                Margin="0,0,10,0"
                                Click="SaveNewButton_Click"/>

                        <Button x:Name="SaveChangesButton" 
                                Content="💾 Сохранить" 
                                Style="{StaticResource SaveButtonStyle}"
                                Background="{StaticResource AccentColor}"
                                Width="120"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                Click="SaveChangesButton_Click"/>

                        <Button x:Name="DeleteButton" 
                                Content="🗑️ Удалить" 
                                Style="{StaticResource DeleteButtonStyle}"
                                Width="120"
                                Visibility="Collapsed"
                                Click="DeleteButton_Click"/>
                    </StackPanel>

                    <!-- ID скрытой записи (для отладки) -->
                    <TextBlock x:Name="IdLabel" 
                               Foreground="Gray" 
                               FontSize="12" 
                               Margin="0,10,0,0"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Кнопка закрытия -->
            <Button Content="← Назад" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="100"
                    Height="35"
                    Background="{StaticResource LightGray}"
                    Foreground="{StaticResource TextColor}"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Click="ClosePage_Click"/>
        </StackPanel>

        <!-- Правая колонка - список должностей -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Список должностей" 
                       Style="{StaticResource SubtitleTitleStyle}"
                       Margin="0,0,0,15"/>

            <!-- Поиск -->
            <TextBox x:Name="SearchBox" 
                     Text="Поиск по названию..." 
                     Style="{StaticResource InputFieldStyle}"
                     Margin="0,0,0,10"
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"
                     TextChanged="SearchBox_TextChanged"/>

            <!-- Список -->
            <ListBox x:Name="PostsListView" 
                     Height="350"
                     Background="White"
                     BorderBrush="{StaticResource BorderColor}"
                     BorderThickness="1"
                     SelectionChanged="PostsListView_SelectionChanged"
                     MouseDoubleClick="PostsListView_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" 
                                Margin="2" 
                                CornerRadius="4" 
                                Background="{StaticResource PrimaryLightColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayPost}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryColor}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Статистика -->
            <TextBlock x:Name="CountLabel" 
                       Foreground="{StaticResource TextColor}" 
                       FontSize="12" 
                       Margin="0,10,0,0"
                       Opacity="0.7"/>
        </StackPanel>
    </Grid>
</Page>