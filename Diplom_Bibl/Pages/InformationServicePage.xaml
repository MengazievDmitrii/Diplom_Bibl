<Page x:Class="Diplom_Bibl.Pages.InformationServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:System="clr-namespace:System;assembly=mscorlib"
      mc:Ignorable="d" 
      Title="Информационное обслуживание"
      Background="#F5F5F5"
      MinWidth="800">

    <Page.Resources>
        <!-- Стили остаются без изменений -->
        <Style x:Key="SectionBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
        </Style>

        <Style x:Key="StatBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Информационное обслуживание"
                       Style="{StaticResource SectionTitleStyle}"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <!-- Кнопка возврата -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Возврат книг" 
                        Name="ReturnBooksButton" 
                        Style="{StaticResource SaveButtonStyle}" 
                        Click="ReturnBooksButton_Click"
                        Padding="20,10"
                        FontSize="14"
                        ToolTip="Перейти к оформлению возврата книг"/>
            </StackPanel>

            <!-- Основной контент - две колонки -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="300" MaxWidth="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ КОЛОНКА (статистика) -->
                <ScrollViewer Grid.Column="0" 
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,15,0"
                              Padding="0,0,10,0">
                    <StackPanel>
                        <!-- Дата -->
                        <Border Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Дата" 
                                           Style="{StaticResource LabelStyle}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                <DatePicker x:Name="DatePicker"
                                            Style="{StaticResource DatePickerStyle}"
                                            SelectedDateChanged="DatePicker_SelectedDateChanged"
                                            DisplayDateStart="2024-01-01"
                                            DisplayDateEnd="{x:Static System:DateTime.Today}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Выберите дату для отображения статистики"/>
                            </StackPanel>
                        </Border>

                        <!-- Статистика за день (автоматическая) -->
                        <Border Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Статистика за день" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,15"/>

                                <!-- Выдано книг -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Выдано книг:" 
                                               VerticalAlignment="Center"
                                               FontSize="14"/>
                                    <Border Grid.Column="1" Style="{StaticResource StatBoxStyle}" MinWidth="60">
                                        <TextBlock x:Name="BooksCountStat" 
                                                   Text="0" 
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Возвращено книг -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Возвращено книг:" 
                                               VerticalAlignment="Center"
                                               FontSize="14"/>
                                    <Border Grid.Column="1" Style="{StaticResource StatBoxStyle}" MinWidth="60">
                                        <TextBlock x:Name="ReturnedBooksCountStat" 
                                                   Text="0" 
                                                   FontSize="18" 
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessColor}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ПРАВАЯ КОЛОНКА (выдача книг) -->
                <ScrollViewer Grid.Column="1" 
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,0">
                    <StackPanel>
                        <!-- Тип выдачи -->
                        <Border Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Тип выдачи" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,12"/>
                                <WrapPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ReaderTypeRadio" 
                                                 Content="Читателю" 
                                                 GroupName="IssueType"
                                                 IsChecked="True"
                                                 Checked="IssueType_Checked"
                                                 Margin="0,0,30,5"
                                                 FontSize="14"
                                                 ToolTip="Выдача книг конкретному читателю"/>
                                    <RadioButton x:Name="GroupTypeRadio" 
                                                 Content="Группе (на урок)"
                                                 GroupName="IssueType"
                                                 Checked="IssueType_Checked"
                                                 FontSize="14"
                                                 ToolTip="Групповая выдача книг на занятие"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Поиск читателя -->
                        <Border x:Name="ReaderSearchSection" Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Поиск читателя" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,10"/>
                                <TextBox x:Name="ReaderSearchBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         GotFocus="ReaderSearchBox_GotFocus"
                                         LostFocus="ReaderSearchBox_LostFocus"
                                         TextChanged="ReaderSearchBox_TextChanged"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Stretch"
                                         ToolTip="Начните вводить фамилию, имя или номер читательского билета"/>
                                <ListBox x:Name="ReadersListBox"
         MaxHeight="150"
         Style="{StaticResource ModernListBoxStyle}"
         ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
         SelectionChanged="ReadersListBox_SelectionChanged"
         Visibility="Collapsed"
         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayInfo}" 
                       Foreground="{StaticResource PrimaryColor}"
                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Поиск группы, преподавателя, студента (для групповой выдачи) -->
                        <Border x:Name="GroupSearchSection" 
                                Style="{StaticResource SectionBoxStyle}"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Поиск группы" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,10"/>
                                <TextBox x:Name="GroupSearchBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         GotFocus="GroupSearchBox_GotFocus"
                                         LostFocus="GroupSearchBox_LostFocus"
                                         TextChanged="GroupSearchBox_TextChanged"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Stretch"
                                         ToolTip="Введите код группы (например, ИС-121)"/>
                                <ListBox x:Name="GroupsListBox"
                                         MaxHeight="120"
                                         Style="{StaticResource ModernListBoxStyle}"
                                         ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                                         SelectionChanged="GroupsListBox_SelectionChanged"
                                         Visibility="Collapsed"
                                         DisplayMemberPath="GroupCode"
                                         HorizontalContentAlignment="Stretch"/>

                                <TextBlock Text="Преподаватель" 
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,10,0,5"/>
                                <TextBox x:Name="TeacherSearchBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         GotFocus="TeacherSearchBox_GotFocus"
                                         LostFocus="TeacherSearchBox_LostFocus"
                                         TextChanged="TeacherSearchBox_TextChanged"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Stretch"
                                         ToolTip="Введите фамилию преподавателя"/>
                                <ListBox x:Name="TeachersListBox"
         MaxHeight="120"
         Style="{StaticResource ModernListBoxStyle}"
         ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
         SelectionChanged="TeachersListBox_SelectionChanged"
         Visibility="Collapsed"
         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FullName}" 
                       Foreground="{StaticResource PrimaryColor}"
                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="Студент" 
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,10,0,5"/>
                                <TextBox x:Name="StudentSearchBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         GotFocus="StudentSearchBox_GotFocus"
                                         LostFocus="StudentSearchBox_LostFocus"
                                         TextChanged="StudentSearchBox_TextChanged"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Stretch"
                                         ToolTip="Введите фамилию или номер билета студента"/>
                                <ListBox x:Name="StudentsListBox"
         MaxHeight="120"
         Style="{StaticResource ModernListBoxStyle}"
         ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
         SelectionChanged="StudentsListBox_SelectionChanged"
         Visibility="Collapsed"
         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayInfo}" 
                       Foreground="{StaticResource PrimaryColor}"
                       TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Поиск книги -->
                        <Border Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Выберите книгу" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,10"/>
                                <TextBox x:Name="BookSearchBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         GotFocus="BookSearchBox_GotFocus"
                                         LostFocus="BookSearchBox_LostFocus"
                                         TextChanged="BookSearchBox_TextChanged"
                                         Margin="0,0,0,10"
                                         HorizontalAlignment="Stretch"
                                         ToolTip="Введите название книги или фамилию автора"/>
                                <ListBox x:Name="BooksListBox"
         MaxHeight="200"
         Style="{StaticResource ModernListBoxStyle}"
         ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
         SelectionChanged="BooksListBox_SelectionChanged"
         Visibility="Collapsed"
         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8">
                                                <TextBlock Text="{Binding TitleBook}" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryColor}"
                           FontSize="14"
                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding AuthorName}" 
                           FontSize="12"
                           Foreground="{StaticResource TextColor}"
                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="Доступно: " FontSize="11" Foreground="{StaticResource TextColor}"/>
                                                    <TextBlock Text="{Binding AvailableCopies}" FontSize="11" Foreground="{StaticResource SuccessColor}" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Выбранная книга -->
                        <Border x:Name="SelectedBookPanel"
                                Background="{StaticResource PrimaryLightColor}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SelectedBookTitle" 
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryColor}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="SelectedBookAuthor" 
                                               FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="24"
                                        Height="24"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{StaticResource DangerColor}"
                                        FontWeight="Bold"
                                        Click="ClearSelectedBook_Click"
                                        ToolTip="Очистить выбранную книгу"/>
                            </Grid>
                        </Border>

                        <!-- Количество и выдача -->
                        <Border Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Количество" 
                                                   Style="{StaticResource LabelStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <TextBox x:Name="QuantityBox"
                                                 Text="1"
                                                 Style="{StaticResource InputFieldStyle}"
                                                 PreviewTextInput="NumberValidationTextBox"
                                                 IsEnabled="False"
                                                 HorizontalAlignment="Stretch"
                                                 ToolTip="Количество экземпляров для выдачи"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Доступно" 
                                                   Style="{StaticResource LabelStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,5"/>
                                        <Border Background="{StaticResource LightGray}"
                                                Padding="10,8"
                                                MinHeight="40"
                                                CornerRadius="4">
                                            <TextBlock x:Name="AvailableQuantityText" 
                                                       Text="0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       FontSize="16"
                                                       Foreground="{StaticResource PrimaryColor}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="📅 Дата возврата" 
                                               Style="{StaticResource LabelStyle}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,5"/>
                                    <DatePicker x:Name="ReturnDatePicker" 
                                                Style="{StaticResource DatePickerStyle}"
                                                SelectedDate="{x:Static System:DateTime.Now}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip="Плановая дата возврата книг"/>
                                    <TextBlock Text="По умолчанию: +14 дней (индивид.), +30 дней (групп.)"
                                               FontSize="10"
                                               Foreground="Gray"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <Button x:Name="CreateIssueButton"
                                        Content="📤 Создать выдачу"
                                        Style="{StaticResource SaveButtonStyle}"
                                        Height="45"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Margin="0,20,0,0"
                                        Click="CreateIssueButton_Click"
                                        HorizontalAlignment="Stretch"
                                        ToolTip="Оформить выдачу книг выбранному читателю/группе"/>
                            </StackPanel>
                        </Border>

                        <!-- История выдач за сегодня -->
                        <Border Style="{StaticResource SectionBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="Выдачи за выбранную дату" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}"
                   Margin="0,0,0,15"/>
                                <DataGrid x:Name="IssuesDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="40"
                  MaxHeight="400"
                  Background="White"
                  BorderBrush="{StaticResource BorderColor}"
                  BorderThickness="1"
                  HorizontalScrollBarVisibility="Auto"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата выдачи" 
                                    Binding="{Binding IssuanceDate, StringFormat=dd.MM.yyyy HH:mm}" 
                                    Width="130"
                                    MinWidth="100"/>
                                        <DataGridTextColumn Header="Читатель/Группа" 
                                    Binding="{Binding RecipientName}" 
                                    Width="*"
                                    MinWidth="150"/>
                                        <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding RecipientType}" 
                                    Width="80"
                                    MinWidth="70"/>
                                        <DataGridTextColumn Header="Книга" 
                                    Binding="{Binding DisplayBook}" 
                                    Width="250"
                                    MinWidth="200"/>
                                        <DataGridTextColumn Header="Кол-во" 
                                    Binding="{Binding Quantity}" 
                                    Width="60"
                                    MinWidth="50"/>
                                        <DataGridTextColumn Header="Возврат" 
                                    Binding="{Binding PlannedReturnDate, StringFormat=dd.MM.yyyy}" 
                                    Width="100"
                                    MinWidth="90"/>
                                        <DataGridTemplateColumn Header="Статус" Width="100" MinWidth="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="12"
                                    Background="{Binding OverdueColor}"
                                    Padding="8,4">
                                                        <TextBlock Text="{Binding Status}" 
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>