<Page x:Class="Diplom_Bibl.Pages.AddPublicationFormat"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление форматами изданий" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление форматами изданий" 
                   Style="{StaticResource SectionTitleStyle}"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: форма ввода -->
            <StackPanel Grid.Column="0" Width="400" Margin="15">
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Название формата *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbFormatName" Style="{StaticResource InputFieldStyle}" MaxLength="100"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Описание" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbDescription" AcceptsReturn="True" Height="80" 
                             Style="{StaticResource InputFieldStyle}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="BtnSaveNew" Content="Сохранить"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="BtnSaveNew_Click" Width="160" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSaveChanges" Content="Сохранить изменения"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="BtnSaveChanges_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="BtnDelete" Content="Удалить"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="BtnDelete_Click" Visibility="Collapsed" Width="100"/>
                </StackPanel>
            </StackPanel>

            <!-- Правая колонка: список форматов -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputFieldStyle}"
                         TextChanged="SearchBox_TextChanged" Margin="0,0,0,10"
                         ToolTip="Поиск по названию" Height="36" Padding="10,0"/>

                <DataGrid x:Name="DgFormats" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeight="35" AlternatingRowBackground="{StaticResource LightGray}"
                          Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                          MouseDoubleClick="DgFormats_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="35"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding FormatName}" Width="250"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2" Content="← Закрыть" Style="{StaticResource PrimaryButtonStyle}"
                Background="{StaticResource LightGray}" Foreground="{StaticResource TextColor}"
                HorizontalAlignment="Center" Width="160" Click="ClosePage_Click" Margin="0,20,0,0"/>
    </Grid>
</Page>