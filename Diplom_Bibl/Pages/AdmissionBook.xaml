<Page x:Class="Diplom_Bibl.Pages.AdmissionBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Приходные накладные" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление приходом книг" 
                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Форма ввода -->
            <StackPanel Grid.Column="0" Width="400" Margin="15">
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Номер накладной" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbReceiptNumber" IsEnabled="False" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Дата" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbReceiptDate" IsEnabled="False" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Ответственное лицо" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Orientation="Horizontal"> <ComboBox x:Name="CbResponsible"
          DisplayMemberPath="FullName"
          SelectedValuePath="ID_User"
          Style="{StaticResource InputFieldStyleCb}"
          Height="36" Width="365"/>
                    <Button Content="+" Width="36" Click="Button_Click"/>
                    </StackPanel>
                    
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Комментарий" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TbComment" AcceptsReturn="True" Height="80" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSaveNew" Content="Создать новый приход"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="BtnSaveNew_Click" Width="264" Margin="0,0,10,0"/>

                    <Button x:Name="BtnSaveChanges" Content="Сохранить изменения"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="BtnSaveChanges_Click" Visibility="Collapsed" Margin="0,0,10,0"/>

                    <Button x:Name="BtnDelete" Content="Удалить"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="BtnDelete_Click" Visibility="Collapsed" Background="Red" Foreground="White"/>
                </StackPanel>
            </StackPanel>

            <!-- Список -->
            <Grid Grid.Column="1" Width="500">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="LightGray" Margin="0,0,0,10">
                    <TextBlock Text="Поиск" 
               Style="{StaticResource LabelStyle}" 
               Margin="10,4,443,23"/>
                    <TextBox x:Name="SearchBox" Grid.Row="0" Margin="57,7,-4,23"
                         ToolTip="Поиск по ответственному или комментарию..."
                         TextChanged="SearchBox_TextChanged" Style="{StaticResource InputFieldStyle}"/>
                </Grid>
                <ListView x:Name="LvReceipts" Grid.Row="1" 
                          MouseDoubleClick="LvReceipts_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Номер" Width="100" DisplayMemberBinding="{Binding ReceiptNumber}"/>
                            <GridViewColumn Header="Дата" Width="120" DisplayMemberBinding="{Binding ReceiptDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                            <GridViewColumn Header="Ответственный" Width="150" DisplayMemberBinding="{Binding ResponsiblePerson}"/>
                            <GridViewColumn Header="Комментарий" Width="180" DisplayMemberBinding="{Binding Comment}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <Button Grid.Row="2" Content="Закрыть" Style="{StaticResource SaveButtonStyle}"
                HorizontalAlignment="Center" Width="160" Click="ClosePage_Click"/>
    </Grid>
</Page>