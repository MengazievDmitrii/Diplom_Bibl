<Page x:Class="Diplom_Bibl.Pages.AdmissionBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление приходом книг" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Page.Resources>
        <!-- Стиль для центрирования ячеек -->
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Управление приходом книг" 
                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15"/>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="BtnPrint" 
                    Content="📄 Сформировать акт"
                    Style="{StaticResource SaveButtonStyle}"
                    Width="180"
                    Height="36"
                    Click="BtnPrint_Click"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnRefresh" 
                    Content="🔄 Обновить список"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Background="{StaticResource LightGray}"
                    Foreground="{StaticResource TextColor}"
                    Width="150"
                    Height="36"
                    Click="BtnRefresh_Click"/>
        </StackPanel>

        <!-- Поиск -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="🔍 Поиск по накладным:" 
                       Style="{StaticResource LabelStyle}" 
                       Margin="0,0,0,5"/>
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource InputFieldStyle}"
                     TextChanged="SearchBox_TextChanged" 
                     ToolTip="Поиск по номеру, поставщику или комментарию"
                     Height="36" Padding="10,0"/>
        </StackPanel>

        <!-- Список приходных накладных -->
        <DataGrid x:Name="LvReceipts" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  RowHeight="35" AlternatingRowBackground="{StaticResource LightGray}"
                  Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                  SelectionChanged="LvReceipts_SelectionChanged">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding ReceiptNumber}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Дата" 
                                    Binding="{Binding ReceiptDate, StringFormat='dd.MM.yyyy HH:mm'}" 
                                    Width="140"/>

                <DataGridTextColumn Header="Ответственный" 
                                    Binding="{Binding ResponsiblePerson}" 
                                    Width="180"/>

                <DataGridTextColumn Header="Поставщик" 
                                    Binding="{Binding SupplierName}" 
                                    Width="150"/>

                <DataGridTextColumn Header="Комментарий" 
                                    Binding="{Binding Comment}" 
                                    Width="*" MinWidth="200"/>

                <!-- Исправленная колонка количества книг -->
                <DataGridTextColumn Header="Кол-во книг" 
                                    Binding="{Binding BooksCount}" 
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Информационная панель внизу -->
        <Border Grid.Row="4" Background="{StaticResource LightGray}" CornerRadius="6" 
                Padding="10" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="SelectedInfo" Text="Выберите накладную для печати" 
                           Foreground="{StaticResource TextColor}" FontSize="12"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>