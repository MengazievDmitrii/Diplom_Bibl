<Page x:Class="Diplom_Bibl.Pages.AddReader"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      xmlns:controls="clr-namespace:Diplom_Bibl.Controls"
      mc:Ignorable="d" 
      Title="AddReader" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- Кнопка назад (вверху слева) -->
        <Button Grid.Row="0" Grid.Column="0" 
                Content="← Назад" 
                Style="{StaticResource PrimaryButtonStyle}"
                Width="100"
                Height="35"
                Background="{StaticResource LightGray}"
                Foreground="{StaticResource TextColor}"
                HorizontalAlignment="Left"
                Margin="0,0,0,10"
                Click="ClosePage_Click"/>

        <!-- Левая колонка - форма добавления/редактирования -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" MaxHeight="700">
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Добавление читателя" Style="{StaticResource SectionTitleStyle}"/>

                <Border Background="White" 
                        Padding="20" 
                        CornerRadius="8" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1"
                        Effect="{StaticResource DropShadowEffect}">

                    <StackPanel>
                        <Label Name="IDReader" Visibility="Collapsed"/>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Номер читательского билета" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="CardNumberTb" Style="{StaticResource InputFieldStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Фамилия" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="LastNameTb" Style="{StaticResource InputFieldStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Имя" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="FirstNameTb" Style="{StaticResource InputFieldStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Отчество" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="MiddleNameTb" Style="{StaticResource InputFieldStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Тип читателя" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="TRCb" 
                                      Style="{StaticResource InputFieldStyleCb}"
                                      DisplayMemberPath="DisplayTr" 
                                      SelectedValuePath="ID"/>
                        </StackPanel>

                        <!-- Панель специальности (видна только для студентов) -->
                        <StackPanel x:Name="SpecialityPanel" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Специальность" Style="{StaticResource LabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SpCb" Grid.Column="0" 
                                          Style="{StaticResource InputFieldStyleCb}"
                                          DisplayMemberPath="DisplaySp" 
                                          SelectedValuePath="ID"/>
                                <Button Name="AddSp" Grid.Column="1" 
                                        Content="+" 
                                        Width="36" 
                                        Height="36"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddSp_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Панель для группы (видна только для студентов) -->
                        <StackPanel x:Name="GrPanel" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Группа" Style="{StaticResource LabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="GrCb" Grid.Column="0" 
                                          Style="{StaticResource InputFieldStyleCb}"
                                          DisplayMemberPath="DisplayGr" 
                                          SelectedValuePath="ID"/>
                                <Button Name="AddGr" Grid.Column="1" 
                                        Content="+" 
                                        Width="36" 
                                        Height="36"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddGr_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Панель для должности (видна только для сотрудников) -->
                        <StackPanel x:Name="PostPanel" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock Text="Должность" Style="{StaticResource LabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PostCb" Grid.Column="0" 
                                          Style="{StaticResource InputFieldStyleCb}"
                                          DisplayMemberPath="DisplayPost" 
                                          SelectedValuePath="ID"/>
                                <Button Name="AddPost" Grid.Column="1" 
                                        Content="+" 
                                        Width="36" 
                                        Height="36"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddPost_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Номер телефона" Style="{StaticResource LabelStyle}"/>
                            <xctk:MaskedTextBox x:Name="NumPhTb" 
                                                Mask="+7 (000) 000-00-00" 
                                                Style="{StaticResource InputFieldStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Домашний адрес" Style="{StaticResource LabelStyle}"/>
                            <controls:AddressSearchTextBox 
                                x:Name="HomeAdressTb" 
                                SelectedAddress="{Binding HomeAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Состоит читателем библиотеки с" Style="{StaticResource LabelStyle}"/>
                            <DatePicker x:Name="MembershipStartDatePicker" 
                                        Style="{StaticResource DatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Дата оформления читательского билета" Style="{StaticResource LabelStyle}"/>
                            <DatePicker x:Name="FormFillDatePicker" 
                                        Style="{StaticResource DatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="AddReaderBtn" 
                                    Content="Добавить нового читателя" 
                                    Style="{StaticResource SaveButtonStyle}" 
                                    Width="200"
                                    Click="AddReaderBtn_Click"/>
                            <Button x:Name="UpdateReaderBtn" 
                                    Content="Сохранить изменения" 
                                    Style="{StaticResource SaveButtonStyle}" 
                                    Width="200" 
                                    Margin="10,0,0,0" 
                                    Visibility="Collapsed" 
                                    Click="UpdateReaderBtn_Click"/>
                            <Button x:Name="DeleteReaderBtn" 
                                    Content="Удалить читателя" 
                                    Style="{StaticResource DeleteButtonStyle}" 
                                    Width="200" 
                                    Margin="10,0,0,0" 
                                    Visibility="Collapsed" 
                                    Click="DeleteReaderBtn_Click"/>
                            <Button x:Name="PrintCardBtn" 
                                    Content="🖨️ Печать билета" 
                                    Style="{StaticResource SaveButtonStyle}" 
                                    Width="200" 
                                    Margin="10,0,0,0" 
                                    Background="{StaticResource SuccessColor}"
                                    Click="PrintCardBtn_Click"
                                    Visibility="Visible"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Правая колонка - список читателей -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Список читателей" 
                       Style="{StaticResource SubtitleTitleStyle}"
                       Margin="0,0,0,15"/>

            <TextBox x:Name="SearchReaderTb" 
                     Text="Поиск по фамилии или номеру билета..." 
                     Style="{StaticResource InputFieldStyle}" 
                     Margin="0,0,0,10" 
                     GotFocus="SearchBox_GotFocus" 
                     LostFocus="SearchBox_LostFocus"
                     TextChanged="SearchReader_TextChanged"/>

            <ListBox x:Name="ReadersListView" 
                     Height="500"
                     Style="{StaticResource ModernListBoxStyle}"
                     ItemContainerStyle="{StaticResource ModernListBoxItemStyle}"
                     SelectionChanged="ReadersListView_SelectionChanged" 
                     MouseDoubleClick="ReadersListView_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" 
                                Background="{StaticResource PrimaryLightColor}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayInfo}" 
                                           FontSize="14" 
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryColor}"/>
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Text="Тип: " 
                                               FontSize="11" 
                                               Foreground="{StaticResource TextColor}"
                                               Opacity="0.7"/>
                                    <TextBlock Text="{Binding TypeName}" 
                                               FontSize="11" 
                                               Foreground="{StaticResource SuccessColor}"
                                               FontWeight="SemiBold"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="CountLabel" 
                       Foreground="{StaticResource TextColor}" 
                       FontSize="12" 
                       Margin="0,10,0,0"
                       Opacity="0.7"/>
        </StackPanel>
    </Grid>
</Page>