<Page x:Class="Diplom_Bibl.Pages.AddReader"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      Title="AddReader">

    <Grid Margin="24">
        <TextBlock Text="Добавление читателя" Style="{StaticResource SectionTitleStyle}"/>
        <StackPanel Margin="25,40,25,25">
            <Label  Name="IDReader" Visibility="Collapsed"/>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Номер читательского билета" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="CardNumberTb" Style="{StaticResource InputFieldStyle}" Width="250" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Фамилия" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="LastNameTb" Style="{StaticResource InputFieldStyle}"  Width="250" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Имя" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="FirstNameTb" Style="{StaticResource InputFieldStyle}"  Width="250" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Отчество" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="MiddleNameTb" Style="{StaticResource InputFieldStyle}"  Width="250" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Тип читателя" Style="{StaticResource LabelStyle}" Margin="2"/>
                <ComboBox x:Name="TRCb"  DisplayMemberPath="DisplayTr" SelectedValuePath="ID" Margin="2"  Width="250"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Специальность" Style="{StaticResource LabelStyle}" Margin="2"/>
                <ComboBox x:Name="SpCb"  DisplayMemberPath="DisplaySp" SelectedValuePath="ID" Margin="2"  Width="250"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Группа" Style="{StaticResource LabelStyle}" Margin="2"/>
                <ComboBox x:Name="GrCb"  DisplayMemberPath="DisplayGr" SelectedValuePath="ID" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Номер телефона" Style="{StaticResource LabelStyle}" Margin="2"/>
                <xctk:MaskedTextBox x:Name="NumPhTb" Mask="+7 (000) 000-00-00" Style="{StaticResource InputFieldStyle}" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Домашний адрес" Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="HomeAdressTb" Style="{StaticResource InputFieldStyle}" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Состоит читателем библиотеки с " Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="StartReaderTb" Style="{StaticResource InputFieldStyle}" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal">
                <TextBlock Text="Дата оформления читательского билета " Style="{StaticResource LabelStyle}" Margin="2"/>
                <TextBox x:Name="RegistrationDate" Style="{StaticResource InputFieldStyle}" Margin="2"/>
            </StackPanel>
            <StackPanel Margin="5"  Orientation="Horizontal">
                <Button x:Name="AddReaderBtn" Content="Добавить нового читателя" Style="{StaticResource SaveButtonStyle}" Width="220"/>
                <Button x:Name="UpdateReader" Content="Сохранить измененения" Style="{StaticResource SaveButtonStyle}" Width="220" Margin="5"/>
                <Button x:Name="DeleteReader" Content="Удалить читателя" Style="{StaticResource DeleteButtonStyle}" Width="220" Margin="5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
