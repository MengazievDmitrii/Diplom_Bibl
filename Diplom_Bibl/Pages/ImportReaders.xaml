<Page x:Class="Diplom_Bibl.Pages.ImportReaders"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="ImportReaders" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Импорт читателей из Excel" 
                   Style="{StaticResource SectionTitleStyle}"/>

        <!-- Инструкция -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightColor}"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="📋 Требования к файлу Excel:" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryColor}"
                           Margin="0,0,0,10"/>

                <TextBlock Text="• Первая строка должна содержать заголовки колонок" 
                           Margin="20,0,0,5"/>
                <TextBlock Text="• Обязательные колонки: Номер читательского билета, Фамилия, Имя, Тип читателя" 
                           Margin="20,0,0,5"/>
                <TextBlock Text="• Опциональные колонки: Отчество, Группа, Должность, Специальность, Номер телефона, Адрес регистрации, Состои читателем с, Дата оформления читательского билета" 
                           Margin="20,0,0,5"/>
                <TextBlock Text="• Даты рекомендуется указывать в формате ДД.ММ.ГГГГ" 
                           Margin="20,0,0,5"/>
            </StackPanel>
        </Border>

        <!-- Панель выбора файла -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="20"
                Margin="0,0,0,20"
                Effect="{StaticResource DropShadowEffect}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Файл Excel:" 
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="FilePathTextBox" 
         Grid.Column="1"
         Style="{StaticResource InputFieldStyle}"
         IsReadOnly="True"
         Padding="8"
         TextChanged="FilePathTextBox_TextChanged"/>

                <Button x:Name="BrowseButton" 
                        Grid.Column="2"
                        Content="📁 Обзор" 
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="100"
                        Height="35"
                        Margin="10,0,0,0"
                        Click="BrowseButton_Click"/>
            </Grid>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

            <Button x:Name="ImportButton" 
                    Content="📥 Импортировать" 
                    Style="{StaticResource SaveButtonStyle}"
                    Width="180"
                    Height="40"
                    Margin="0,0,20,0"
                    Click="ImportButton_Click"
                    IsEnabled="False"/>

            <Button x:Name="DownloadTemplateButton" 
                    Content="📋 Скачать шаблон" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Background="{StaticResource AccentColor}"
                    Width="180"
                    Height="40"
                    Click="DownloadTemplateButton_Click"/>
        </StackPanel>

        <!-- Результаты импорта -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="15"
                VerticalAlignment="Top"
                MaxHeight="300">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Результаты импорта:" 
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColor}"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Всего строк: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="TotalRowsText" Text="0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Успешно: " FontWeight="SemiBold" Foreground="{StaticResource SuccessColor}"/>
                            <TextBlock x:Name="SuccessRowsText" Text="0" Foreground="{StaticResource SuccessColor}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="С ошибками: " FontWeight="SemiBold" Foreground="{StaticResource DangerColor}"/>
                            <TextBlock x:Name="ErrorRowsText" Text="0" Foreground="{StaticResource DangerColor}"/>
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="ErrorsListBox" 
                             MaxHeight="150"
                             Background="{StaticResource LightGray}"
                             BorderThickness="0"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Foreground="{StaticResource DangerColor}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox x:Name="WarningsListBox" 
                             MaxHeight="150"
                             Background="{StaticResource LightGray}"
                             BorderThickness="0"
                             Margin="0,5,0,0"
                             Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Foreground="{StaticResource WarningColor}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Margin="2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>