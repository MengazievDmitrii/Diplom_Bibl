<Page x:Class="Diplom_Bibl.Pages.BookRequestsManagement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление заявками" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📋 Управление заявками на книги" 
                   FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="#D0D0D0" BorderThickness="1"
                Padding="15" Margin="0,0,0,20"
                Effect="{StaticResource DropShadowEffect}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="🔍 Поиск" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBox x:Name="TbSearch" Height="38" FontSize="13"
                             TextChanged="TbSearch_TextChanged"
                             ToolTip="Поиск по номеру заявки, преподавателю или группе"
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             Padding="8,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="📊 Статус заявки" FontSize="14" FontWeight="SemiBold" 
                               Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CbStatusFilter" Height="38" FontSize="13"
                              SelectionChanged="CbStatusFilter_SelectionChanged"
                              BorderBrush="#BDC3C7" BorderThickness="1"
                              Padding="8,0">
                        <ComboBoxItem Content="Все заявки" IsSelected="True"/>
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="В обработке"/>
                        <ComboBoxItem Content="Готова"/>
                        <ComboBoxItem Content="Выдана"/>
                        <ComboBoxItem Content="Отменена"/>
                        <ComboBoxItem Content="Просрочена"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основной контент: DataGrid + Панель деталей с вертикальным скроллом -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Список заявок -->
            <DataGrid Grid.Row="0" x:Name="DgRequests" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      RowHeight="45" AlternatingRowBackground="#F9F9F9"
                      Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                      SelectionChanged="DgRequests_SelectionChanged"
                      FontSize="13">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#34495E"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ заявки" Binding="{Binding RequestNumber}" Width="130"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding RequestDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Заявитель" Binding="{Binding UserName}" Width="160"/>
                    <DataGridTextColumn Header="Группа" Binding="{Binding GroupCode}" Width="100"/>
                    <DataGridTextColumn Header="Занятие" Binding="{Binding LessonName}" Width="160"/>
                    <DataGridTextColumn Header="Дата занятия" Binding="{Binding LessonDate, StringFormat='dd.MM.yyyy'}" Width="110"/>
                    <DataGridTextColumn Header="Книг" Binding="{Binding TotalBooks}" Width="70"/>
                    <DataGridTemplateColumn Header="Статус" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,4"
                                        Background="{Binding StatusColor}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusName}" 
                                               Foreground="White" FontSize="11"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Действия" Width="320">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="📖 Просмотр" Width="75" Height="30"
                                            Background="#3498DB" Foreground="White"
                                            BorderThickness="0" 
                                            Click="ViewRequest_Click"
                                            Tag="{Binding ID_Request}"
                                            Margin="0,0,5,0"
                                            Cursor="Hand"/>
                                    <Button Content="✅ Подтвердить" Width="85" Height="30"
                                            Background="#27AE60" Foreground="White"
                                            BorderThickness="0" 
                                            Click="ConfirmRequest_Click"
                                            Tag="{Binding ID_Request}"
                                            Visibility="{Binding ConfirmVisible}"
                                            Margin="0,0,5,0"
                                            Cursor="Hand"/>
                                    <Button Content="📤 Выдать" Width="75" Height="30"
                                            Background="#E67E22" Foreground="White"
                                            BorderThickness="0" 
                                            Click="IssueBooks_Click"
                                            Tag="{Binding ID_Request}"
                                            Visibility="{Binding IssueVisible}"
                                            Margin="0,0,5,0"
                                            Cursor="Hand"/>
                                    <Button Content="❌ Отменить" Width="75" Height="30"
                                            Background="#E74C3C" Foreground="White"
                                            BorderThickness="0" 
                                            Click="CancelRequest_Click"
                                            Tag="{Binding ID_Request}"
                                            Visibility="{Binding CancelVisible}"
                                            Margin="0,0,5,0"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Панель деталей заявки с вертикальным скроллом (внизу) -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#D0D0D0" BorderThickness="1"
                    Padding="20" Margin="0,20,0,0" Visibility="Collapsed"
                    x:Name="DetailsPanel"
                    Effect="{StaticResource DropShadowEffect}">

                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📄 Детали заявки" FontSize="18" FontWeight="SemiBold"
                                   Foreground="#2C3E50" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✖ Закрыть" 
                                Width="80" Height="30"
                                Background="#E74C3C" Foreground="White"
                                BorderThickness="0" 
                                Click="CloseDetailsPanel_Click"
                                Cursor="Hand"/>
                    </Grid>

                    <!-- Информация о заявке -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock x:Name="TbRequestNumber" FontWeight="Bold" FontSize="14" 
                                       Foreground="#2980B9" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TbUserName" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TbUserType" FontSize="13" Margin="0,5,0,0" Foreground="Gray"/>
                            <TextBlock x:Name="TbLessonInfo" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TbRequestDate" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TbGroupInfo" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TbStatus" FontSize="13" Margin="0,5,0,0"/>
                            <TextBlock x:Name="TbExpirationDate" FontSize="13" 
                                       Foreground="#E74C3C" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Список книг с вертикальным скроллом -->
                    <TextBlock Text="Список книг:" FontWeight="SemiBold" FontSize="14" 
                               Margin="0,0,0,8"/>
                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="DgRequestItems" AutoGenerateColumns="False"
                                  IsReadOnly="True" 
                                  RowHeight="35" AlternatingRowBackground="#F9F9F9"
                                  BorderBrush="#D0D0D0" BorderThickness="1"
                                  HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#ECF0F1"/>
                                    <Setter Property="Foreground" Value="#2C3E50"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="35"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название книги" Binding="{Binding BookTitle}" Width="*" MinWidth="300"/>
                                <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>