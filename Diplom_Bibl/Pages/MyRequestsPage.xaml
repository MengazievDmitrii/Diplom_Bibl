<Page x:Class="Diplom_Bibl.Pages.MyRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои заявки" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📋 Мои заявки на книги" 
                   Style="{StaticResource SectionTitleStyle}" 
                   Margin="0,0,0,20"/>

        <!-- Фильтры -->
        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Padding="15" Margin="0,0,0,20"
                Effect="{StaticResource DropShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="🔍 Поиск" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,8"/>
                    <TextBox x:Name="TbSearch" Height="38" FontSize="13"
                             Style="{StaticResource InputFieldStyle}"
                             TextChanged="TbSearch_TextChanged"
                             ToolTip="Поиск по номеру заявки, занятию или группе"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="📊 Статус заявки" FontSize="14" FontWeight="SemiBold" 
                               Foreground="{StaticResource TextColor}" Margin="0,0,0,8"/>
                    <ComboBox x:Name="CbStatusFilter" Height="38" FontSize="13"
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="CbStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Все заявки" IsSelected="True"/>
                        <ComboBoxItem Content="Новая"/>
                        <ComboBoxItem Content="В обработке"/>
                        <ComboBoxItem Content="Выдана"/>
                        <ComboBoxItem Content="Отменена"/>
                        <ComboBoxItem Content="Просрочена"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список заявок с ScrollViewer -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <DataGrid x:Name="DgRequests" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      RowHeight="45" AlternatingRowBackground="{StaticResource LightGray}"
                      Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                      SelectionChanged="DgRequests_SelectionChanged"
                      FontSize="13"
                      MinHeight="200"
                      MaxHeight="400"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ заявки" Binding="{Binding RequestNumber}" Width="140"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding RequestDate, StringFormat='dd.MM.yyyy'}" Width="100"/>
                    <DataGridTextColumn Header="Занятие" Binding="{Binding LessonName}" Width="200"/>
                    <DataGridTextColumn Header="Дата занятия" Binding="{Binding LessonDate, StringFormat='dd.MM.yyyy'}" Width="110"/>
                    <DataGridTextColumn Header="Книг" Binding="{Binding TotalBooks}" Width="70"/>
                    <DataGridTemplateColumn Header="Статус" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,4"
                                        Background="{Binding StatusColor}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusName}" 
                                               Foreground="White" FontSize="11"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Действия" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="📖 Просмотр" Width="80" Height="30"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Background="{StaticResource AccentColor}"
                                        Click="ViewRequest_Click"
                                        Tag="{Binding ID_Request}"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>

        <!-- Панель деталей заявки -->
        <Border Grid.Row="3" Background="White" CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                Padding="20" Margin="0,20,0,0" Visibility="Collapsed"
                x:Name="DetailsPanel"
                Effect="{StaticResource DropShadowEffect}">

            <StackPanel>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="📄 Детали заявки" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColor}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="✖ Закрыть" 
                            Width="80" Height="30"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="CloseDetailsPanel_Click"
                            Cursor="Hand"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock x:Name="TbRequestNumber" FontWeight="Bold" FontSize="14" 
                                   Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TbLessonInfo" FontSize="13" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TbRequestDate" FontSize="13" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="TbGroupInfo" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TbStatus" FontSize="13" Margin="0,5,0,0"/>
                        <TextBlock x:Name="TbExpirationDate" FontSize="13" 
                                   Foreground="{StaticResource DangerColor}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Список книг:" FontWeight="SemiBold" FontSize="14" 
                           Foreground="{StaticResource TextColor}" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <DataGrid x:Name="DgRequestItems" AutoGenerateColumns="False"
                              IsReadOnly="True" 
                              RowHeight="35" AlternatingRowBackground="{StaticResource LightGray}"
                              BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                              HeadersVisibility="Column">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="35"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название книги" Binding="{Binding BookTitle}" Width="*" MinWidth="350"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Page>