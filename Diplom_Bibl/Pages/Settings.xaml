<Page x:Class="Diplom_Bibl.Pages.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Settings">

    <Grid Margin="24">
        <TextBlock Text="Настройки" Style="{StaticResource SectionTitleStyle}"/>
        <Grid Margin="5,35,5,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button x:Name="AddSpeciality" Content="Добавить специальность" Grid.Column="0" Grid.Row="0" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddSpeciality_Click"/>
            <Button x:Name="AddGroup" Content="Добавить группу" Grid.Column="0" Grid.Row="1" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddGroup_Click"/>
            <Button x:Name="AddGener" Content="Добавить жанр" Grid.Column="0" Grid.Row="2" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddGener_Click"/>
            <Button x:Name="AddAuthor" Content="Добавить автора" Grid.Column="0" Grid.Row="3" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddAuthor_Click"/>
            <Button x:Name="AddPublishingHouse" Content="Добавить издательство" Grid.Column="0" Grid.Row="4" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddPublishingHouse_Click"/>
            <Button x:Name="AddStatusBook" Content="Добавить статус книги" Grid.Column="0" Grid.Row="5" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddStatusBook_Click"/>
            <Button x:Name="AddViewBook" Content="Добавить вид книги" Grid.Column="0" Grid.Row="6" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Click="AddViewBook_Click"/>

        </Grid>
    </Grid>
</Page>
