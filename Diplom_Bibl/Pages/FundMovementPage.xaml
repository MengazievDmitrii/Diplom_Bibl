<Page x:Class="Diplom_Bibl.Pages.FundMovementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1100"
      Title="FundMovementPage" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="FilterSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect" Value="{StaticResource DropShadowEffect}"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="OverdueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="NormalTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📊 Движение фонда" 
                   Style="{StaticResource SectionTitleStyle}"/>

        <!-- Статистика -->
        <Border Grid.Row="1" Style="{StaticResource FilterSectionStyle}">
            <StackPanel>
                <TextBlock Text="Статистика фонда" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryColor}"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Всего на руках" 
                                       FontSize="12"
                                       Foreground="{StaticResource TextColor}"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TotalIssuedText" 
                                       Text="0" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="книг" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Просрочено" 
                                       FontSize="12"
                                       Foreground="{StaticResource TextColor}"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="OverdueText" 
                                       Text="0" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="книг" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Студенты" 
                                       FontSize="12"
                                       Foreground="{StaticResource TextColor}"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="StudentsCountText" 
                                       Text="0" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SuccessColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="читателей" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Групповые выдачи" 
                                       FontSize="12"
                                       Foreground="{StaticResource TextColor}"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="GroupIssuancesText" 
                                       Text="0" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="выдач" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextColor}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Индивидуальные" 
                                       FontSize="12"
                                       Foreground="{StaticResource TextColor}"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="IndividualIssuancesText" 
                                       Text="0" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentColor}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="выдач" 
                                       FontSize="11"
                                       Foreground="{StaticResource TextColor}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Панель фильтрации -->
        <Border Grid.Row="2" Style="{StaticResource FilterSectionStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,10">
                    <TextBlock Text="🔍 Поиск" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="SearchBox" 
                             Text="Поиск по книге, читателю, группе..."
                             Style="{StaticResource InputFieldStyle}"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <!-- Фильтр по типу выдачи -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                    <TextBlock Text="Тип выдачи" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="TypeFilterCombo" 
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem Content="Все выдачи" IsSelected="True"/>
                        <ComboBoxItem Content="Индивидуальные"/>
                        <ComboBoxItem Content="Групповые"/>
                    </ComboBox>
                </StackPanel>

                <!-- Статус фильтр -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock Text="Статус" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="StatusFilterCombo" 
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="Активные"/>
                        <ComboBoxItem Content="Просроченные"/>
                        <ComboBoxItem Content="Возвращенные"/>
                    </ComboBox>
                </StackPanel>

                <!-- Кнопка сброса -->
                <Button Grid.Row="1" Grid.Column="2" 
                        Content="✖ Сбросить фильтры"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Background="{StaticResource LightGray}"
                        Foreground="{StaticResource TextColor}"
                        Width="120"
                        Height="35"
                        Click="ClearFilters_Click"
                        HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Таблица с движением фонда -->
        <DataGrid Grid.Row="3" 
                  x:Name="FundMovementGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="32"
                  AlternatingRowBackground="{StaticResource LightGray}"
                  Background="White"
                  BorderBrush="{StaticResource BorderColor}"
                  BorderThickness="1"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  MouseDoubleClick="FundMovementGrid_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="38"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding IssuanceTypeDisplay}" 
                                    Width="90"/>
                <DataGridTextColumn Header="Инв. №" 
                                    Binding="{Binding InventaryNumber}" 
                                    Width="100"/>
                <DataGridTextColumn Header="Название книги" 
                                    Binding="{Binding BookTitle}" 
                                    Width="250"/>
                <DataGridTextColumn Header="Получатель" 
                                    Binding="{Binding RecipientDisplay}" 
                                    Width="180"/>
                <DataGridTextColumn Header="Группа/Преподаватель" 
                                    Binding="{Binding GroupTeacherDisplay}" 
                                    Width="150"/>
                <DataGridTextColumn Header="Дата выдачи" 
                                    Binding="{Binding IssuanceDate, StringFormat=dd.MM.yyyy}" 
                                    Width="100"/>
                <DataGridTextColumn Header="План возврата" 
                                    Binding="{Binding PlannedReturnDate, StringFormat=dd.MM.yyyy}" 
                                    Width="100"/>
                <DataGridTemplateColumn Header="Статус" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10"
                                    Background="{Binding StatusColor}"
                                    Padding="5,2">
                                <TextBlock Text="{Binding StatusDisplay}" 
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Кол-во" 
                                    Binding="{Binding Quantity}" 
                                    Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Индикатор загрузки -->
        <Grid Grid.Row="3" 
              x:Name="LoadingPanel" 
              Background="#80FFFFFF"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <ProgressBar Width="200" 
                            Height="20" 
                            IsIndeterminate="True"
                            Foreground="{StaticResource PrimaryColor}"/>
                <TextBlock Text="Загрузка данных..." 
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>