<Page x:Class="Diplom_Bibl.Pages.NotificationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      Title="Уведомления"
      Background="#F8F9FA"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Конвертер для обратного преобразования видимости (для непрочитанных уведомлений) -->
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </Page.Resources>

    <Grid>
        <!-- ИНДИКАТОР ЗАГРУЗКИ -->
        <Grid x:Name="LoadingOverlay" Background="#C0FFFFFF" Visibility="Collapsed" ZIndex="100">
            <Border Background="White" 
                    CornerRadius="10" 
                    Width="300" 
                    Height="120" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Effect="{StaticResource DropShadowEffect}">
                <StackPanel Margin="20" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" 
                                 Width="260" 
                                 Height="20" 
                                 Margin="0,0,0,15"/>
                    <TextBlock x:Name="LoadingText" 
                               Text="Загрузка..." 
                               FontSize="14" 
                               Foreground="#2C3E50" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ОСНОВНОЙ КОНТЕНТ -->
        <Grid x:Name="MainContentGrid" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок и бейдж -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="🔔 Уведомления" 
                           FontSize="24" 
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryColor}"/>
                <Border x:Name="UnreadBadge"
                        Background="#E74C3C"
                        CornerRadius="20"
                        Padding="10,3"
                        Margin="15,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="UnreadCountText" 
                               Text="0" 
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="14"/>
                </Border>
            </StackPanel>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="MarkAllReadBtn" 
                        Content="✅ Отметить всё как прочитанное"
                        Style="{StaticResource SaveButtonStyle}"
                        Width="220" 
                        Height="35"
                        Click="MarkAllReadBtn_Click"
                        Margin="0,0,10,0"/>
                <Button x:Name="RefreshBtn" 
                        Content="🔄 Обновить"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="120" 
                        Height="35"
                        Click="RefreshBtn_Click"
                        Margin="0,0,10,0"/>
                <Button x:Name="BackBtn" 
                        Content="← Назад"
                        Style="{StaticResource DefaultButtonStyle}"
                        Width="100" 
                        Height="35"
                        Click="BackBtn_Click"/>

                <!-- Информация о пагинации -->
                <TextBlock x:Name="PageInfoText" 
                           Text="Страница 1 из 1" 
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"
                           FontSize="11"
                           Foreground="Gray"
                           Opacity="0.7"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Список уведомлений с виртуализацией -->
            <ScrollViewer Grid.Row="3" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="NotificationsList"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding BackgroundColor}"
                                    CornerRadius="8"
                                    Margin="0,5,0,5"
                                    Padding="15,12"
                                    Cursor="Hand"
                                    BorderBrush="#DEE2E6"
                                    BorderThickness="1"
                                    MouseLeftButtonDown="Notification_Click">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Иконка уведомления -->
                                    <Border Grid.Column="0" 
                                            Width="45" 
                                            Height="45" 
                                            CornerRadius="22.5"
                                            Background="{Binding IconColor}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconText}" 
                                                   FontSize="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Текст уведомления -->
                                    <StackPanel Grid.Column="1" Margin="15,0">
                                        <TextBlock Text="{Binding NotificationType}" 
                                                   FontSize="14" 
                                                   FontWeight="{Binding FontWeight}"
                                                   Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Message}" 
                                                   FontSize="12" 
                                                   Foreground="#34495E"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="Заявка №: " FontSize="11" Foreground="#7F8C8D"/>
                                            <TextBlock Text="{Binding RequestNumber}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="#2980B9"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="#BDC3C7"/>
                                            <TextBlock Text="{Binding FormattedDate}" 
                                                       FontSize="11" 
                                                       Foreground="#7F8C8D"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Индикатор непрочитанного -->
                                    <Border Grid.Column="2" 
                                            Width="10" 
                                            Height="10" 
                                            CornerRadius="5" 
                                            Background="#E74C3C"
                                            VerticalAlignment="Top"
                                            Margin="0,5,10,0"
                                            Visibility="{Binding IsRead, Converter={StaticResource InverseBooleanConverter}}"/>

                                    <!-- Кнопка перехода -->
                                    <Button Grid.Column="2" 
                                            Content="Перейти"
                                            Width="80" 
                                            Height="30"
                                            Background="#3498DB" 
                                            Foreground="White"
                                            BorderThickness="0" 
                                            Click="ViewRequest_Click"
                                            Tag="{Binding RequestID}"
                                            Visibility="{Binding GoToButtonVisibility}"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Сообщение, если нет уведомлений -->
            <TextBlock Grid.Row="3" 
                       x:Name="NoNotificationsText"
                       Text="📭 У вас нет непрочитанных уведомлений"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>