<Page x:Class="Diplom_Bibl.Pages.DisposalAct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Акт списания книг" >

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок акта -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Акт списания книг" Style="{StaticResource SectionTitleStyle}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="№ акта:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TbActNumber" Style="{StaticResource InputFieldStyle}" 
                         Width="150" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" Text="Дата:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="3" x:Name="DpDate" Style="{StaticResource DatePickerStyle}" 
                            Width="150"/>
            </Grid>
        </StackPanel>

        <!-- Участники и основание -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Участники (ФИО и должности):" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TbParticipants" 
                         Style="{StaticResource InputFieldStyle}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Основание списания:" Style="{StaticResource LabelStyle}"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="CbReason"
                        Style="{StaticResource InputFieldStyleCb}"
                        DisplayMemberPath="ReasonName"
                        SelectedValuePath="ID_Reason"
                        Height="36" Width="350"  Margin="5"/>
                    <!--<Button x:Name="AddReasonDisposal" Content="+" Width="35" Height="35" Click="AddReasonDisposal_Click"/>-->
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- Основной контейнер для динамической части -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <!-- Поиск книги -->
                <RowDefinition Height="Auto"/>
                <!-- Карточка найденной книги -->
                <RowDefinition Height="Auto"/>
                <!-- Таблица книг в акте -->
                <RowDefinition Height="*"/>
                <!-- Итоговая сумма -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки действия -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- === 1. Поиск книги === -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Поиск по инвентарному номеру:" 
                   Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TbSearchInv" 
                 Style="{StaticResource InputFieldStyle}" Margin="10,0"/>
                <Button Grid.Column="2" Content="Найти" Click="BtnFindBook_Click" 
                Style="{StaticResource PrimaryButtonStyle}" Width="80" Margin="10,0,0,0" Height="36" VerticalAlignment="Top"/>
            </Grid>

            <!-- === 2. Детали найденной книги === -->
            <StackPanel Grid.Row="1" x:Name="PnBookDetails" Visibility="Hidden" Margin="0,0,0,15">
                <Border BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="16"
                Background="{StaticResource LightGray}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Инв. №:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LbInventory" FontWeight="Bold" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Автор, заглавие:" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Height="19"/>
                            <TextBlock Grid.Column="1" x:Name="LbTitle" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Издательство, год:" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Grid.ColumnSpan="2" Margin="0,0,578,0"/>
                            <TextBlock Grid.Column="1" x:Name="LbPubYear" FontWeight="Bold" FontSize="14"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Цена:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LbPrice" FontWeight="Bold" FontSize="14"/>
                        </Grid>

                        <Button Content="Добавить в акт" 
                        Click="BtnAddToAct_Click"
                        Style="{StaticResource SaveButtonStyle}"
                        HorizontalAlignment="Left"
                        Width="160"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- === 3. Список книг в акте === -->
            <DataGrid Grid.Row="2" x:Name="DgItems" 
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="True"
              Visibility="Hidden"
              RowHeight="32"
              AlternatingRowBackground="{StaticResource LightGray}"
              MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ п/п" Binding="{Binding RowNum}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Автор, заглавие" Binding="{Binding Title}" Width="280"/>
                    <DataGridTextColumn Header="Цена (руб.)" Binding="{Binding PriceRub}" Width="80"/>
                    <DataGridTextColumn Header="коп." Binding="{Binding PriceKop}" Width="60"/>
                    <DataGridTextColumn Header="Кол-во экз." Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat=N2}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- === 4. Итоговая сумма === -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                <TextBlock Text="Итого:" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextColor}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TbTotal" Text="0.00" FontWeight="Bold" FontSize="16" Foreground="#0056B3"/>
                <TextBlock Text=" руб." FontSize="14" Foreground="{StaticResource TextColor}"/>
            </StackPanel>

            <!-- === 5. Кнопки === -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20">
                <Button Content="Сформировать акт" Click="BtnGenerateAct_Click" 
                Style="{StaticResource SaveButtonStyle}" 
                Width="160" Margin="0,0,10,0"/>
                <Button Content="Закрыть" Click="BtnClose_Click" 
                Style="{StaticResource DeleteButtonStyle}" 
                Width="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>