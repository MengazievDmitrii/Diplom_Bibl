<Page x:Class="Diplom_Bibl.Pages.BulkAddBooks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="950" d:DesignWidth="1000"
      Title="Массовое добавление книг" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="InfoBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для панели создания акта -->
        <Style x:Key="ReceiptFormStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LightGray}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Массовое добавление книг" 
                       Style="{StaticResource SectionTitleStyle}"/>

            <!-- Информационный блок -->
            <Border Grid.Row="1" 
                    Style="{StaticResource InfoBoxStyle}" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ℹ️ Инструкция" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryColor}"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="1. Если акта поступления ещё нет - создайте его в разделе ниже
                               2. Заполните данные о книге
                               3. Укажите количество экземпляров. 
                               4.Нажмите 'Сохранить книги'" 
                               TextWrapping="Wrap"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ========== ПАНЕЛЬ СОЗДАНИЯ НОВОГО АКТА ПОСТУПЛЕНИЯ ========== -->
            <Border Grid.Row="2" Style="{StaticResource ReceiptFormStyle}">
                <StackPanel>
                    <TextBlock Text="📋 Создание нового акта поступления" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Foreground="{StaticResource PrimaryColor}"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ответственное лицо -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,5">
                            <TextBlock Text="Ответственное лицо *" 
                                       Style="{StaticResource LabelStyle}"
                                       FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="NewReceiptResponsibleCombo"
                                          Grid.Column="0"
                                          Style="{StaticResource InputFieldStyleCb}"
                                          DisplayMemberPath="FullName"
                                          SelectedValuePath="ID_User"
                                          Height="32"/>
                                <Button Grid.Column="1"
                                        Content="+"
                                        Width="32"
                                        Height="32"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddResponsibleUser_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Поставщик -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,5">
                            <TextBlock Text="Поставщик" 
                                       Style="{StaticResource LabelStyle}"
                                       FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="NewReceiptSupplierCombo"
                                          Grid.Column="0"
                                          Style="{StaticResource InputFieldStyleCb}"
                                          DisplayMemberPath="SupplierName"
                                          SelectedValuePath="ID_Supplier"
                                          Height="32"/>
                                <Button Grid.Column="1"
                                        Content="+"
                                        Width="32"
                                        Height="32"
                                        Margin="5,0,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="AddSupplier_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Комментарий -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,10,0">
                            <TextBlock Text="Комментарий к акту" 
                                       Style="{StaticResource LabelStyle}"
                                       FontSize="12"/>
                            <TextBox x:Name="NewReceiptCommentBox"
                                     Style="{StaticResource InputFieldStyle}"
                                     Height="30"/>
                        </StackPanel>

                        <!-- Кнопка создания акта -->
                        <Button Grid.Row="1" Grid.Column="2"
                                Content="➕ Создать акт"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="140"
                                Height="36"
                                Click="CreateNewReceipt_Click"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== ОСНОВНАЯ ФОРМА ДОБАВЛЕНИЯ КНИГИ ========== -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="20"
                    Effect="{StaticResource DropShadowEffect}"
                    Margin="0,10,0,0">

                <StackPanel>
                    <TextBlock Text="Данные книги" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColor}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                            <!-- Название книги -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Название книги *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TitleBox"
                                         Style="{StaticResource InputFieldStyle}"/>
                            </StackPanel>

                            <!-- Автор -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Автор *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AuthorCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayAuthors"
                                              SelectedValuePath="ID"
                                              IsEditable="True"
                                              TextSearch.TextPath="DisplayAuthors"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddAuthor_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Категория книги -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Категория книги" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CategoryCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="CategoryName"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddCategory_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Вид издания -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Вид издания *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="EditionTypeCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="EditionTypeName"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddEditionType_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Формат издания -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Формат издания" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FormatCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="FormatName"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddFormat_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Акт поступления (выбор существующего) -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Акт поступления *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ReceiptCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayReceipt"
                                              SelectedValuePath="ID"
                                              SelectionChanged="ReceiptCombo_SelectionChanged"/>
                                    <Button Grid.Column="1"
                                            Content="🔄"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="Обновить список актов"
                                            Click="RefreshReceipts_Click"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                            <!-- Издательство -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Издательство" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PublisherCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayPH"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddPublisher_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Жанр -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Жанр" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="GenreCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayGen"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddGenre_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Статус -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Статус" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="StatusCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayStatus"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddStatus_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Год издания -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Год издания *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="YearBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="NumberValidationTextBox"
                                         MaxLength="4"/>
                            </StackPanel>

                            <!-- Цена -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Цена" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="PriceBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="PriceValidationTextBox"
                                         TextChanged="PriceBox_TextChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Аннотация -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,10">
                            <TextBlock Text="Аннотация" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="AnnotationBox" 
                                     AcceptsReturn="True" 
                                     Height="80" 
                                     Style="{StaticResource InputFieldStyle}" 
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Количество экземпляров + Начальный инвентарный номер -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{StaticResource PrimaryLightColor}"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,10,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Количество экземпляров -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="📚 Количество экземпляров:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,5,15,5"/>

                                <TextBox x:Name="QuantityBox"
                                         Grid.Row="0" Grid.Column="1"
                                         Text="1"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="NumberValidationTextBox"
                                         TextChanged="QuantityBox_TextChanged"/>

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="шт."
                                           VerticalAlignment="Center"
                                           Margin="10,5,0,5"
                                           Foreground="#666666"/>

                                <!-- Начальный инвентарный номер -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="🏷️ Начальный инвентарный номер:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,5,15,5"/>

                                <TextBox x:Name="StartInventoryBox"
                                         Grid.Row="1" Grid.Column="1"
                                         Text=""
                                         Width="120"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="InventoryNumberValidationTextBox"
                                         TextChanged="StartInventoryBox_TextChanged"
                                         MaxLength="6"
                                         ToolTip="Введите номер вручную или оставьте пустым для автоматической генерации"/>

                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="(6 цифр)"
                                           VerticalAlignment="Center"
                                           Margin="10,5,0,5"
                                           Foreground="#666666"
                                           FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Предпросмотр инвентарных номеров -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{StaticResource LightGray}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Предпросмотр инвентарных номеров:"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="InventoryPreviewText"
                                           Text="000001, 000002, 000003, ..."
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryColor}"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="GenerateActButton"
                                Content="📄 Сформировать акт"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="160"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="GenerateActButton_Click"/>
                        <Button x:Name="SaveButton"
                                Content="💾 Сохранить книги"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="180"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="SaveButton_Click"/>
                        <Button x:Name="ClearButton"
                                Content="🔄 Очистить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{StaticResource LightGray}"
                                Foreground="{StaticResource TextColor}"
                                Width="120"
                                Height="40"
                                Click="ClearButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>