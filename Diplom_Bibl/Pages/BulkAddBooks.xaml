<Page x:Class="Diplom_Bibl.Pages.BulkAddBooks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="900"
      Title="BulkAddBooks" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Page.Resources>
        <Style x:Key="InfoBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Массовое добавление книг" 
                       Style="{StaticResource SectionTitleStyle}"/>

            <!-- Информационный блок -->
            <Border Grid.Row="1" 
                    Style="{StaticResource InfoBoxStyle}" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ℹ️ Инструкция" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryColor}"
                               FontSize="14"
                               Margin="0,0,0,5"/>
                    <TextBlock Text="Заполните данные о книге один раз. Укажите количество экземпляров, и система автоматически создаст указанное количество записей с уникальными инвентарными номерами." 
                               TextWrapping="Wrap"
                               FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Форма добавления книги -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Padding="20"
                    Effect="{StaticResource DropShadowEffect}">

                <StackPanel>
                    <TextBlock Text="Данные книги" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColor}"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                            <!-- Название книги -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Название книги *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TitleBox"
                                         Style="{StaticResource InputFieldStyle}"/>
                            </StackPanel>

                            <!-- Автор -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Автор *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="AuthorCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayAuthors"
                                              SelectedValuePath="ID"
                                              IsEditable="True"
                                              TextSearch.TextPath="DisplayAuthors"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddAuthor_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Вид книги -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Вид книги *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ViewBookCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayViewBook"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddViewBook_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Акт поступления (перенесен в левую колонку) -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Акт поступления" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ReceiptCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayReceipt"
                                              SelectedValuePath="ID"
                                              SelectionChanged="ReceiptCombo_SelectionChanged"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddReceipt_Click"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Правая колонка -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                            <!-- Издательство -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Издательство" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PublisherCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayPH"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddPublisher_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Жанр -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Жанр" 
                                           Style="{StaticResource LabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="GenreCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource InputFieldStyleCb}"
                                              DisplayMemberPath="DisplayGen"
                                              SelectedValuePath="ID"/>
                                    <Button Grid.Column="1"
                                            Content="+"
                                            Width="36"
                                            Height="36"
                                            Margin="5,0,0,0"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddGenre_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Год издания -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Год издания *" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="YearBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="NumberValidationTextBox"
                                         MaxLength="4"/>
                            </StackPanel>

                            <!-- Цена -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Цена" 
                                           Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="PriceBox"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="PriceValidationTextBox"
                                         TextChanged="PriceBox_TextChanged"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Количество экземпляров (на всю ширину) -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{StaticResource PrimaryLightColor}"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,15,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="📚 Количество экземпляров:"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>

                                <TextBox x:Name="QuantityBox"
                                         Grid.Column="1"
                                         Text="1"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource InputFieldStyle}"
                                         PreviewTextInput="NumberValidationTextBox"
                                         TextChanged="QuantityBox_TextChanged"/>

                                <TextBlock Grid.Column="2"
                                           Text="шт."
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="#666666"/>
                            </Grid>
                        </Border>

                        <!-- Предпросмотр инвентарных номеров (возвращен на место) -->
                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                Background="{StaticResource LightGray}"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Предпросмотр инвентарных номеров:"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,5"/>
                                <TextBlock x:Name="InventoryPreviewText"
                                           Text="000001, 000002, 000003, ..."
                                           FontSize="12"
                                           Foreground="{StaticResource PrimaryColor}"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SaveButton"
                                Content="💾 Сохранить книги"
                                Style="{StaticResource SaveButtonStyle}"
                                Width="180"
                                Height="40"
                                Margin="0,0,10,0"
                                Click="SaveButton_Click"/>
                        <Button x:Name="ClearButton"
                                Content="🔄 Очистить"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Background="{StaticResource LightGray}"
                                Foreground="{StaticResource TextColor}"
                                Width="120"
                                Height="40"
                                Click="ClearButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>