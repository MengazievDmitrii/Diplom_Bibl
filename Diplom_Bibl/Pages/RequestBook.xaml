<Page x:Class="Diplom_Bibl.Pages.RequestBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="Оформление заявки на выдачу книг">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="📝 Подача заявки на выдачу книг" 
                       FontSize="24" FontWeight="Bold" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,20"/>

            <!-- Основная форма -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#D0D0D0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Данные заявки" FontSize="16" FontWeight="SemiBold"
                              Style="{StaticResource SubtitleTitleStyle}" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <StackPanel Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Text="Тип заявки" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox x:Name="TbUserType" IsEnabled="False" Height="35" Padding="8,0"/>
                            </StackPanel>

                            <StackPanel x:Name="GroupPanel" Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Text="Группа *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CbGroup" Height="35" Padding="8,0" Style="{StaticResource InputFieldStyleCb}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Название занятия / предмета *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox x:Name="TbLessonName" Height="35" Padding="8,0" MaxLength="200" Style="{StaticResource InputFieldStyle}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Дата занятия *" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <DatePicker x:Name="DpLessonDateSimple" Height="35" 
                                            SelectedDateChanged= "DpLessonDateSimple_SelectedDateChanged"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Пара / Время занятия" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CbLessonPeriod" 
              Height="35" 
              Padding="8,0" 
              Style="{StaticResource InputFieldStyleCb}"
              DisplayMemberPath="DisplayText"
              SelectedValuePath="PeriodNumber"
             />
                                <TextBlock x:Name="TbTimeInfo" 
               FontSize="11" 
               Foreground="Gray" 
               Margin="0,5,0,0"
               Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#E3F2FD"
                                CornerRadius="8" Padding="15" Margin="15,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Информация" FontWeight="Bold" 
                                           Foreground="#1565C0" Margin="0,0,0,10"/>
                                <TextBlock Text="• Заявка создаётся на выбранную дату занятия" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="• Книги бронируются на 3 дня вперёд от даты занятия" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="• После подтверждения библиотекарем книги будут ждать вас" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="• Если не забрать книги в день занятия — бронь снимается" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                                <TextBlock Text="• Статус заявки можно отслеживать в разделе 'Мои заявки'" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Секция добавления книг -->
            <Border Grid.Row="2" Background="White" CornerRadius="8"
                    BorderBrush="#D0D0D0" BorderThickness="1"
                    Padding="20" Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="📚 Выбор книг" FontSize="16" FontWeight="SemiBold"
                               Style="{StaticResource SubtitleTitleStyle}" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TbBookSearch" Grid.Column="0" 
                                 Height="35" Padding="8,0"
                                 TextChanged="TbBookSearch_TextChanged"
                                 ToolTip="Поиск по названию или автору" Style="{StaticResource InputFieldStyle}"/>

                        <Button x:Name="BtnSearchBook" Grid.Column="1" Content="🔍 Поиск"
                                Width="80" Height="35" Margin="10,0,10,0" Click="BtnSearchBook_Click"
                                Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                        <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✖ Очистить"
                                Width="80" Height="35" Click="BtnClearSearch_Click"
                                Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <!-- Список доступных книг -->
                    <DataGrid x:Name="DgAvailableBooks" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              RowHeight="35" AlternatingRowBackground="#F9F9F9"
                              Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                              Margin="0,15,0,15" MouseDoubleClick="DgAvailableBooks_MouseDoubleClick"
                              MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding TitleBook}" Width="300"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="180"/>
                            <DataGridTextColumn Header="Доступно" Binding="{Binding AvailableCopies}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Выбранные книги -->
                    <TextBlock Text="Выбранные книги" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgSelectedBooks" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="True"
                              RowHeight="35" AlternatingRowBackground="#F9F9F9"
                              Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
                          <DataGrid.Columns>
                            <DataGridTextColumn Header="Название книги" Binding="{Binding BookTitle}" Width="300"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="180"/>
                            <DataGridTemplateColumn Header="Количество" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <xctk:IntegerUpDown Value="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                                 Minimum="1" Maximum="{Binding MaxQuantity}"
                                                                 Width="60" Height="30"
                                                                 Increment="1" 
                                                                 AllowSpin="True"
                                                                 ShowButtonSpinner="True"
                                                                 ValueChanged="Quantity_ValueChanged"/>
                                            <TextBlock Text=" шт." VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действия" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Width="30" Height="30"
                                                Background="#E74C3C" Foreground="White"
                                                BorderThickness="0" Cursor="Hand"
                                                Click="BtnRemoveBook_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Итоговая информация -->
                    <Border Background="#ECF0F1" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Итого:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbTotalBooks" Grid.Column="1" Text="0" FontWeight="Bold" 
                                       FontSize="16" Foreground="#2980B9"/>
                            <TextBlock Grid.Column="2" Text=" книг" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnSubmitRequest" Content="📤 Отправить заявку"
                        Width="180" Height="40" Margin="0,0,10,0"
                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnSubmitRequest_Click"/>
                <Button x:Name="BtnCancel" Content="❌ Отмена"
                        Width="120" Height="40"
                        Background="#95A5A6" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>