<Page x:Class="Diplom_Bibl.Pages.RequestBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Подача заявки на книги" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="📝 Подача заявки на книги" 
                       Style="{StaticResource SectionTitleStyle}"/>

            <!-- Основная форма -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    Padding="20" Margin="0,0,0,20" Effect="{StaticResource DropShadowEffect}">

                <StackPanel>
                    <TextBlock Text="Данные заявки" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <!-- Тип заявки (автоматически определяется по пользователю) -->
                            <StackPanel Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Text="Тип заявки" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TbUserType" IsEnabled="False" Style="{StaticResource InputFieldStyle}"/>
                            </StackPanel>

                            <!-- Группа (для преподавателей, которые выбирают группу) -->
                            <StackPanel x:Name="GroupPanel" Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock Text="Группа *" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="CbGroup" Style="{StaticResource InputFieldStyleCb}"
                                          DisplayMemberPath="GroupCode" SelectedValuePath="GroupID"/>
                            </StackPanel>

                            <!-- Название занятия/предмета -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Название занятия / предмета *" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TbLessonName" Style="{StaticResource InputFieldStyle}" MaxLength="200"/>
                            </StackPanel>

                            <!-- Дата занятия -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Дата занятия *" Style="{StaticResource LabelStyle}"/>
                                <DatePicker x:Name="DpLessonDate" Style="{StaticResource DatePickerStyle}"
                                            SelectedDateChanged="DpLessonDate_SelectedDateChanged"/>
                            </StackPanel>

                            <!-- Время занятия -->
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Время занятия" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="TbLessonTime" Style="{StaticResource InputFieldStyle}" 
             MaxLength="5" ToolTip="Формат: ЧЧ:ММ"
             PreviewTextInput="TbLessonTime_PreviewTextInput"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Правая колонка: информация -->
                        <Border Grid.Column="1" Background="{StaticResource PrimaryLightColor}"
                                CornerRadius="8" Padding="15" Margin="15,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Информация" FontWeight="Bold" 
                                           Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,10"/>
                                <TextBlock Text="• Заявка создаётся на выбранную дату занятия" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="• Книги бронируются на 3 дня вперёд от даты занятия" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="• После подтверждения библиотекарем книги будут ждать вас" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="• Если не забрать книги в день занятия — бронь снимается" FontSize="12" Margin="0,0,0,5"/>
                                <TextBlock Text="• Статус заявки можно отслеживать в разделе 'Мои заявки'" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Секция добавления книг -->
            <Border Grid.Row="2" Background="White" CornerRadius="8"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                    Padding="20" Margin="0,0,0,20" Effect="{StaticResource DropShadowEffect}">

                <StackPanel>
                    <TextBlock Text="📚 Выбор книг" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryColor}" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Поиск книг -->
                        <TextBox x:Name="TbBookSearch" Grid.Column="0" 
                                 Style="{StaticResource InputFieldStyle}"
                                 TextChanged="TbBookSearch_TextChanged"
                                 ToolTip="Поиск по названию или автору"/>

                        <Button x:Name="BtnSearchBook" Grid.Column="1" Content="🔍 Поиск"
                                Style="{StaticResource PrimaryButtonStyle}" Width="80"
                                Margin="10,0,10,0" Click="BtnSearchBook_Click"/>

                        <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✖ Очистить"
                                Style="{StaticResource PrimaryButtonStyle}" Width="80"
                                Background="{StaticResource LightGray}" Foreground="{StaticResource TextColor}"
                                Click="BtnClearSearch_Click"/>
                    </Grid>

                    <!-- Список доступных книг -->
                    <DataGrid x:Name="DgAvailableBooks" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              RowHeight="35" AlternatingRowBackground="{StaticResource LightGray}"
                              Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                              Margin="0,15,0,15" MouseDoubleClick="DgAvailableBooks_MouseDoubleClick"
                              MaxHeight="200">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding TitleBook}" Width="300"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="180"/>
                            <DataGridTextColumn Header="Доступно" Binding="{Binding AvailableCopies}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Выбранные книги -->
                    <TextBlock Text="Выбранные книги" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <DataGrid x:Name="DgSelectedBooks" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="True"
                              RowHeight="35" AlternatingRowBackground="{StaticResource LightGray}"
                              Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="35"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,0"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название книги" Binding="{Binding BookTitle}" Width="300"/>
                            <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="180"/>
                            <DataGridTemplateColumn Header="Количество" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="60" Height="30" TextAlignment="Center"
                                                     PreviewTextInput="NumberValidationTextBox"
                                                     LostFocus="Quantity_LostFocus"/>
                                            <TextBlock Text=" шт." VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действия" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️" Width="30" Height="30"
                                                Background="{StaticResource DangerColor}" Foreground="White"
                                                Click="BtnRemoveBook_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Итоговая информация -->
                    <Border Background="{StaticResource LightGray}" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Итого:" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TbTotalBooks" Grid.Column="1" Text="0" FontWeight="Bold" 
                                       FontSize="16" Foreground="{StaticResource PrimaryColor}"/>
                            <TextBlock Grid.Column="2" Text=" книг" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnSubmitRequest" Content="📤 Отправить заявку"
                        Style="{StaticResource SaveButtonStyle}" Width="180" Height="40"
                        Click="BtnSubmitRequest_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnCancel" Content="❌ Отмена"
                        Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="40"
                        Background="{StaticResource LightGray}" Foreground="{StaticResource TextColor}"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>