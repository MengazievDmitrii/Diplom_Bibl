<Page x:Class="Diplom_Bibl.Pages.LibraryFundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl"
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1200"
      Title="LibraryFundPage" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Библиотечный фонд" 
                   Style="{StaticResource SectionTitleStyle}"/>

        <!-- Кнопки операций -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,10,0,20">
            <Button Content="📥 Поступление" 
                    Name="AdmissionBook" 
                    Style="{StaticResource SaveButtonStyle}" 
                    Height="38" 
                    Width="150" 
                    Click="AdmissionBook_Click" 
                    Margin="0,0,10,0"/>
            <Button Content="📚 Добавить книгу" 
                    Name="AddBook" 
                    Style="{StaticResource SaveButtonStyle}" 
                    Height="38" 
                    Width="150" 
                    Click="AddBook_Click" 
                    Margin="0,0,10,0"/>
            <!-- В панель кнопок добавьте: -->
            <Button Content="📦 Массовое добавление" 
        Name="BulkAddBook" 
        Style="{StaticResource SaveButtonStyle}" 
        Height="38" 
        Width="170" 
        Click="BulkAddBook_Click" 
        Margin="5"/>
            <Button Content="🗑️ Списание" 
                    Name="DisposalBook" 
                    Style="{StaticResource SaveButtonStyle}" 
                    Height="38" 
                    Width="150" 
                    Click="DisposalBook_Click" 
                    Margin="0,0,10,0"/>
            <Button Content="📊 Движение фонда" 
                    Grid.Column="3" 
                    Style="{StaticResource SaveButtonStyle}" 
                    Height="38" 
                    Width="150" 
                    Margin="0,0,0,0" 
                    Visibility="Collapsed"/>
        </StackPanel>

        <!-- Заголовок списка -->
        <TextBlock Grid.Row="2" 
                   Text="Состав книжного фонда" 
                   Style="{StaticResource SubtitleTitleStyle}"/>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,20"
                Effect="{StaticResource DropShadowEffect}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="🔍 Поиск:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}"/>
                    <TextBox x:Name="TbSearch" 
                             Width="400" 
                             TextChanged="TbSearch_TextChanged"
                             Style="{StaticResource InputFieldStyle}"
                             Padding="8"
                             GotFocus="SearchBox_GotFocus"
                             LostFocus="SearchBox_LostFocus"/>
                    <TextBlock x:Name="SearchCountLabel" 
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextColor}"
                               Opacity="0.7"/>
                </StackPanel>

                <!-- Фильтры - первая строка -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Фильтры:" 
                               VerticalAlignment="Center" 
                               Margin="0,0,10,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextColor}"/>
                    <!-- Фильтр по статусу -->
                    <ComboBox x:Name="FilterStatusCombo" 
                              Width="130"
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ID_Status"
                              Margin="0,0,10,5"/>
                    <!-- Фильтр по жанру -->
                    <ComboBox x:Name="FilterGenreCombo" 
                              Width="130"
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ID_Gener"
                              Margin="0,0,10,5"/>
                    <!-- Фильтр по году -->
                    <ComboBox x:Name="FilterYearCombo" 
                              Width="100"
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged"
                              Margin="0,0,10,5">
                        <ComboBoxItem Content="Все годы" IsSelected="True"/>
                    </ComboBox>
                    <ComboBox x:Name="FilterPublisherCombo" 
                              Width="180"
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ID_Publisher"
                              Margin="0,0,10,5"/>
                    <ComboBox x:Name="FilterAuthorCombo" 
                              Width="200"
                              Style="{StaticResource InputFieldStyleCb}"
                              SelectionChanged="FilterCombo_SelectionChanged"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ID_Author"
                              Margin="0,0,10,5"/>

                    <!-- Кнопка сброса фильтров -->
                    <Button x:Name="ClearFiltersBtn" 
                            Content="✖ Сбросить все" 
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="{StaticResource LightGray}"
                            Foreground="{StaticResource TextColor}"
                            Height="35"
                            Width="120"
                            Click="ClearFiltersBtn_Click"
                            Margin="0,0,0,5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Таблица с книгами -->
        <DataGrid Grid.Row="4" 
                  x:Name="DgBooks"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="36"
                  AlternatingRowBackground="{StaticResource LightGray}"
                  Background="White"
                  BorderBrush="{StaticResource BorderColor}"
                  BorderThickness="1"
                  Margin="0,0,0,10"
                  MouseDoubleClick="DgBooks_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Height" Value="38"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Инв. №" 
                                    Binding="{Binding InventaryNumber}" 
                                    Width="100"/>

                <DataGridTextColumn Header="Название книги" 
                                    Binding="{Binding TitleBook}" 
                                    Width="280"/>

                <DataGridTextColumn Header="Автор" 
                                    Binding="{Binding AuthorName}" 
                                    Width="180"/>

                <DataGridTextColumn Header="Год" 
                                    Binding="{Binding YearPublishing}" 
                                    Width="70"/>

                <DataGridTextColumn Header="Издательство" 
                                    Binding="{Binding PublishingHouseName}" 
                                    Width="180"/>

                <DataGridTextColumn Header="Жанр" 
                                    Binding="{Binding GenreName}" 
                                    Width="130"/>

                <DataGridTemplateColumn Header="Статус" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12"
                                    Background="{Binding StatusColor}"
                                    Padding="8,3"
                                    Margin="2">
                                <TextBlock Text="{Binding StatusName}" 
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель статистики -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                Padding="15"
                VerticalAlignment="Bottom"
                Margin="0,10,0,0"
                Effect="{StaticResource DropShadowEffect}">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Всего книг: " 
                           FontWeight="Bold"
                           Foreground="{StaticResource TextColor}"/>
                <TextBlock x:Name="TotalBooksCount" 
                           Text="0" 
                           Margin="0,0,30,0"
                           Foreground="{StaticResource PrimaryColor}"
                           FontWeight="Bold"/>

                <TextBlock Text="В наличии: " 
                           FontWeight="Bold"
                           Foreground="{StaticResource TextColor}"/>
                <TextBlock x:Name="AvailableBooksCount" 
                           Text="0" 
                           Margin="0,0,30,0"
                           Foreground="{StaticResource SuccessColor}"
                           FontWeight="Bold"/>

                <TextBlock Text="Выдано: " 
                           FontWeight="Bold"
                           Foreground="{StaticResource TextColor}"/>
                <TextBlock x:Name="IssuedBooksCount" 
                           Text="0" 
                           Margin="0,0,30,0"
                           Foreground="{StaticResource WarningColor}"
                           FontWeight="Bold"/>

                <TextBlock Text="Списано: " 
                           FontWeight="Bold"
                           Foreground="{StaticResource TextColor}"/>
                <TextBlock x:Name="DisposedBooksCount" 
                           Text="0" 
                           Foreground="{StaticResource DangerColor}"
                           FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>