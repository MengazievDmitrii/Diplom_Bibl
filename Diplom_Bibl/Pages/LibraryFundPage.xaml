<Page x:Class="Diplom_Bibl.Pages.LibraryFundPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LibraryFundPage">

    <StackPanel Margin="24">

        <StackPanel Height="30">
            <TextBlock Text="Библиотечный фонд" Foreground="{StaticResource PrimaryColor}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,372"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Width="750" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    
                </Grid.ColumnDefinitions>
                <Button Content="Поступление" Name="AdmissionBook" Grid.Column="0" Style="{StaticResource SaveButtonStyle}" Height="35" Width="145" Click="AdmissionBook_Click" Margin="5"/>
                <Button Content="Добавить книгу" Name="AddBook" Grid.Column="1" Style="{StaticResource SaveButtonStyle}" Height="35" Width="145" Click="AddBook_Click" Margin="5"/>
                <Button Content="Списание" Name="DisposalBook" Grid.Column="2" Style="{StaticResource SaveButtonStyle}" Height="35" Width="145" Click="DisposalBook_Click" Margin="5"/>
                <Button Content="Движение фонда" Grid.Column="3" Style="{StaticResource SaveButtonStyle}" Height="35" Width="145" Margin="5"/>
            </Grid>
        </StackPanel>

        <StackPanel>
            <StackPanel>
                <TextBlock Text="Состав книжного фонда" Style="{StaticResource SubtitleTitleStyle}"/>
            </StackPanel>
            <!-- Поиск -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="TbSearch" Width="300" 
                     TextChanged="TbSearch_TextChanged"
                     Style="{StaticResource InputFieldStyle}"/>
            </StackPanel>

            <!-- Таблица -->
            <DataGrid Grid.Row="1" x:Name="DgBooks"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="32"
                  AlternatingRowBackground="{StaticResource LightGray}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Инв. №" Binding="{Binding InventaryNumber}" Width="100"/>
                    <DataGridTextColumn Header="Название книги" Binding="{Binding TitleBook}" Width="250"/>
                    <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="150"/>
                    <DataGridTextColumn Header="Год" Binding="{Binding YearPublishing}" Width="80"/>
                    <DataGridTextColumn Header="Издательство" Binding="{Binding PublishingHouseName}" Width="150"/>
                    <DataGridTextColumn Header="Жанр" Binding="{Binding GenreName}" Width="120"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </StackPanel>
</Page>
