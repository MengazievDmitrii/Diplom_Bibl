<Page x:Class="Diplom_Bibl.Pages.AddBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      Title="Книги" Loaded="OnPageLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление книгами" 
                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,15" />

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>

                <!-- Левая колонка: основные поля -->
                <StackPanel Grid.Column="0">
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Инвентарный номер *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TbInventoryNumber" Style="{StaticResource InputFieldStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Название книги *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TbTitle" Style="{StaticResource InputFieldStyle}" Width="440"/>
                    </StackPanel>

                    <!-- Автор -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <StackPanel Width="380">
                            <TextBlock Text="Автор *" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CbAuthor" Style="{StaticResource InputFieldStyleCb}" DisplayMemberPath="DisplayAuthors" SelectedValuePath="ID"/>
                        </StackPanel>
                        <Button Content="+" Width="30" Click="BtnAddAuthor_Click" Margin="5,20,0,0"/>
                    </StackPanel>

                    <!-- Вид книги -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <StackPanel Width="380">
                            <TextBlock Text="Вид книги *" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CbViewBook" DisplayMemberPath="DisplayViewBook" SelectedValuePath="ID" />
                        </StackPanel>
                        <Button Content="+" Width="30" Click="BtnAddViewBook_Click" Margin="5,20,0,0"/>
                    </StackPanel>

                    <!-- Издательство -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <StackPanel Width="380">
                            <TextBlock Text="Издательство" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CbPublisher" DisplayMemberPath="DisplayPH"  SelectedValuePath="ID"/>
                        </StackPanel>
                        <Button Content="+" Width="30" Click="BtnAddPublisher_Click" Margin="5,20,0,0"/>
                    </StackPanel>

                    <!-- Жанр -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <StackPanel Width="380">
                            <TextBlock Text="Жанр" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CbGenre" Style="{StaticResource InputFieldStyleCb}" DisplayMemberPath="DisplayGen" SelectedValuePath="ID"/>
                        </StackPanel>
                        <Button Content="+" Width="30" Click="BtnAddGenre_Click" Margin="5,20,0,0"/>
                    </StackPanel>

                    <!-- Статус -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <StackPanel Width="380">
                            <TextBlock Text="Статус" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CbStatus" Style="{StaticResource InputFieldStyleCb}" DisplayMemberPath="DisplayStatus" SelectedValuePath="ID"/>
                        </StackPanel>
                        <Button Content="+" Width="30" Click="BtnAddStatus_Click" Margin="5,20,0,0"/>
                    </StackPanel>

                    <!-- Приходная накладная -->
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <StackPanel Width="380">
                            <TextBlock Text="Приходная накладная" Style="{StaticResource LabelStyle}"/>
                            <ComboBox x:Name="CbReceipt" Style="{StaticResource InputFieldStyleCb}" DisplayMemberPath="DisplayReceipt" SelectedValuePath="ID"/>
                        </StackPanel>
                        <Button Content="+" Width="30" Click="BtnAddReceipt_Click" Margin="5,20,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Год издания *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TbYear" Style="{StaticResource InputFieldStyle}" MaxLength="4"
                        PreviewTextInput="TbYear_PreviewTextInput"
                         DataObject.Pasting="TbYear_Pasting"
             LostFocus="TbYear_LostFocus"/>
                    </StackPanel>
                    
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Цена *" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TbPrice"
         Style="{StaticResource InputFieldStyle}"
         PreviewTextInput="TbPrice_PreviewTextInput"
         DataObject.Pasting="TbPrice_Pasting"
         LostFocus="TbPrice_LostFocus"
         MaxLength="12"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Аннотация" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TbAnnotation" AcceptsReturn="True" Height="80" Style="{StaticResource InputFieldStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSaveNew" Content="Сохранить книгу"
                                Style="{StaticResource SaveButtonStyle}"
                                Click="BtnSaveNew_Click" Width="200" Margin="0,0,10,0"/>
                        <Button x:Name="BtnSaveChanges" Content="Сохранить изменения"
                                Style="{StaticResource SaveButtonStyle}"
                                Click="BtnSaveChanges_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                        <Button x:Name="BtnDelete" Content="Удалить"
                                Style="{StaticResource DeleteButtonStyle}"
                                Click="BtnDelete_Click" Visibility="Collapsed" Background="Red" Foreground="White"/>
                    </StackPanel>
                    <Button x:Name="BtnGenerateAct" Content="Cформировать акт поступления"
         Style="{StaticResource SaveButtonStyle}"
         Click="BtnGenerateAct_Click" Visibility="Visible" Background="Green" Foreground="White" Margin="5" Width="243"/>
                </StackPanel>

                <!-- Правая колонка: список книг -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="LightGray" Margin="5,9,-5,15">
                        <TextBlock Text="Поиск" 
               Style="{StaticResource LabelStyle}" 
               Margin="10,4,437,23"/>
                        <TextBox x:Name="SearchBox" Grid.Row="0" Margin="57,7,10,23"
                         ToolTip="Поиск Инв.№, Названию, Автору"
                         TextChanged="SearchBox_TextChanged" Style="{StaticResource InputFieldStyle}"/>
                    </Grid>
                    <ListView x:Name="LvBooks" MouseDoubleClick="LvBooks_MouseDoubleClick" Margin="5,80,-5,0" Grid.RowSpan="2" >
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Инв. №" Width="90" DisplayMemberBinding="{Binding InventoryNumber}"/>
                                <GridViewColumn Header="Название" Width="180" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Автор" Width="120" DisplayMemberBinding="{Binding AuthorName}"/>
                                <GridViewColumn Header="Год" Width="60" DisplayMemberBinding="{Binding Year}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть" Style="{StaticResource SaveButtonStyle}"
                HorizontalAlignment="Center" Width="160" Click="ClosePage_Click"/>
    </Grid>
</Page>