<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      xmlns:System="clr-namespace:System;assembly=mscorlib" x:Class="Diplom_Bibl.Pages.Readers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Readers">

    <Grid Margin="24">

        <TextBlock Text="Читатели" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,0"/>
        <StackPanel>
            <StackPanel Margin="0,35,0,25">             
                <Button x:Name="AddReader" Content="Добавить читателя" Style="{StaticResource SaveButtonStyle}" Width="195" Click="AddReader_Click" HorizontalAlignment="Left" />
            </StackPanel>
            <ListBox x:Name="ListReaders">
                <System:String>Здесь будет список читателей из таблицы ReaderForm</System:String>
            </ListBox>

        </StackPanel>
    </Grid>
</Page>
