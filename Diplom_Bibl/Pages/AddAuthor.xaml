<Page x:Class="Diplom_Bibl.Pages.AddAuthor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Diplom_Bibl.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddAuthor">

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Основное содержимое -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопка закрытия -->
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Добавление автора" 
               Style="{StaticResource SectionTitleStyle}" 
               Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Width="400" Margin="15">
                <StackPanel Margin="0,0,0,20">
                    <Label Name="AuthorIDLabel" Visibility="Collapsed"/>
                    <TextBlock Text="Фамилия" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="SurnameAuthorTb" Style="{StaticResource InputFieldStyle}"/>
                    <TextBlock Text="Имя" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="NameAuthorTb" Style="{StaticResource InputFieldStyle}"/>
                    <TextBlock Text="Отчество" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="PatronymicAuthorTb" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveNewRecordButton" 
                         Content="Сохранить нового автора"
                         Style="{StaticResource SaveButtonStyle}"
                         Click="SaveNewRecordButton_Click"
                         Margin="0,0,10,0" Width="264"/>
                    <!-- Отступ между кнопками -->
                    <Button x:Name="SaveChangesButton" 
                        Content="Сохранить изменения"
                        Style="{StaticResource SaveButtonStyle}"
                        Click="SaveChangesButton_Click"
                        HorizontalAlignment="Left"
                        Margin="0,0,10,0" 
                        Visibility="Collapsed"/>
                    <!-- Скрыта по умолчанию -->
                    <Button x:Name="DeleteButton" 
                        Content="Удалить"
                        Style="{StaticResource DeleteButtonStyle}" 
                        Click="DeleteButton_Click"
                        HorizontalAlignment="Left"
                        Background="Red"    
                        Foreground="White"
                        Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
            <!-- Замените ваш StackPanel на этот код -->
            <Grid Grid.Column="1" Width="400" Margin="0">
                <!-- Заголовки столбцов -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Заголовки -->
                        <RowDefinition Height="*"/>
                        <!-- ListView -->
                    </Grid.RowDefinitions>

                    <!-- Строка заголовков -->
                    <Grid Grid.Row="0" Background="LightGray" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Поиск" Style="{StaticResource LabelStyle}" Grid.ColumnSpan="2" Margin="10,4,270,2"/>
                        <TextBox x:Name="SearchBox"
                            Margin="60,0,124,0"
                            Padding="6,4"
                            VerticalAlignment="Center"
                            TextChanged="SearchBox_TextChanged"
                            KeyDown="SearchBox_KeyDown"
                            ToolTip="Введитеназвание жанра (например: Художественный)" Style="{StaticResource InputFieldStyle}" Grid.ColumnSpan="2" Height="30"/>
                    </Grid>

                    <!-- ListView -->
                    <ListView Grid.Row="1" 
                  x:Name="LvAuthors"
                  BorderThickness="0,1,0,0" BorderBrush="Gray"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"  MouseDoubleClick="LvSpecialities_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Фамилия" 
                            Width="100" 
                            DisplayMemberBinding="{Binding SurnameAuthor}" />
                                <GridViewColumn Header="Имя" 
                            Width="100" 
                            DisplayMemberBinding="{Binding NameAuthor}" />
                                <GridViewColumn Header="Отчество" 
                            Width="100" 
                            DisplayMemberBinding="{Binding PatronymicAuthor}" />

                            </GridView>
                        </ListView.View>

                    </ListView>
                </Grid>
            </Grid>
        </Grid>

        <Button Grid.Row="2" x:Name="ClosePage" 
            Content="Закрыть страницу"
            Style="{StaticResource SaveButtonStyle}"
            HorizontalAlignment="Center" Width="160" Height="42"
            Click="ClosePage_Click"
            Margin="0,10,0,10"/>
    </Grid>
</Page>


