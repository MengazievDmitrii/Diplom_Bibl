<Window x:Class="Diplom_Bibl.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom_Bibl"
        mc:Ignorable="d"
        Title="Библиотечная система НМК" 
        Loaded="Window_Loaded"
        MinWidth="1024" 
        MinHeight="700"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Цветовая схема интерфейса -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0056B3"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007BFF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#28A745"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFC107"/>
        <SolidColorBrush x:Key="DangerColor" Color="#DC3545"/>
        <SolidColorBrush x:Key="LightGray" Color="#E9ECEF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="MenuBgColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuHoverColor" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="MenuActiveColor" Color="#E3F2FD"/>

        <!-- Эффект тени для всплывающих окон -->
        <DropShadowEffect x:Key="DropShadowEffect" 
                          BlurRadius="15" 
                          ShadowDepth="3" 
                          Opacity="0.25"/>

        <!-- Стиль кнопок бокового меню -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="icon" Content="{TemplateBinding Content}" />
                                <TextBlock x:Name="text" 
                                           Text="{TemplateBinding Tag}" 
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MenuHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MenuActiveColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="{StaticResource MenuActiveColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Анимация сворачивания/разворачивания меню -->
        <Storyboard x:Key="CollapseMenuStoryboard">
            <DoubleAnimation Storyboard.TargetName="MenuBorder"
                             Storyboard.TargetProperty="Width"
                             Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <!-- Основная сетка разметки окна -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="Auto" MinWidth="60" MaxWidth="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== ЛЕВОЕ БОКОВОЕ МЕНЮ ========== -->
        <Border Grid.Column="0" 
                x:Name="MenuBorder"
                Width="260"
                Background="{StaticResource MenuBgColor}" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="0,0,1,0">

            <Grid>
                <!-- Кнопка гамбургер для сворачивания меню -->
                <Button x:Name="BtnToggleMenu"
                        Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="BtnToggleMenu_Click"
                        Panel.ZIndex="100"
                        ToolTip="Свернуть/развернуть меню">
                    <Path x:Name="ToggleIcon"
                          Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"
                          Fill="{StaticResource PrimaryColor}"
                          Width="16" Height="16"
                          Stretch="Uniform"/>
                </Button>

                <!-- Содержимое меню с прокруткой -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,40,0,0">
                    <StackPanel x:Name="MenuContent" Visibility="Visible">

                        <!-- Заголовок (логотип) -->
                        <StackPanel Orientation="Horizontal" Margin="16,16,16,12" x:Name="MenuHeader">
                            <TextBlock Text="📚" FontSize="24" Margin="0,0,8,0"/>
                            <TextBlock x:Name="MenuHeaderText"
                                       Text="Библиотека НМК-1" 
                                       FontSize="18" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryColor}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Панель информации о пользователе -->
                        <Border x:Name="UserPanel" Margin="12,0,12,12" 
                                Background="{StaticResource PrimaryLightColor}"
                                CornerRadius="8" Padding="12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource PrimaryColor}"
                                            CornerRadius="20" Width="36" Height="36"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="👤" FontSize="18" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" x:Name="UserInfoText">
                                        <TextBlock x:Name="TbUserName" Text="Пользователь" 
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource PrimaryColor}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TbUserRole" Text="Роль" 
                                                   FontSize="11" Foreground="Gray"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Панель уведомлений -->
                        <Border x:Name="NotificationPanel" Margin="12,0,12,12" 
        Background="{StaticResource PrimaryLightColor}"
        CornerRadius="8" Padding="10" Cursor="Hand"
        MouseLeftButtonDown="NotificationPanel_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔔" FontSize="14"/>
                                <TextBlock x:Name="NotificationText"
                   Grid.Column="1" Text="Уведомления" Margin="8,0,0,0" 
                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                <!-- Бейдж с счетчиком -->
                                <Border x:Name="NotificationBadge" 
                Grid.Column="2"
                Background="#E74C3C" 
                CornerRadius="12" 
                MinWidth="22" 
                Height="22"
                Margin="8,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Visibility="Collapsed">
                                    <TextBlock x:Name="TbUnreadCount" 
                       Text="0" 
                       Foreground="White" 
                       FontSize="11" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Separator Margin="12,8,12,8" Height="1" Background="{StaticResource BorderColor}"/>

                        <!-- Кнопки навигации (группируются по ролям) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                            <StackPanel>

                                <!-- Меню для Администратора -->
                                <StackPanel x:Name="MenuAdmin" Visibility="Collapsed">
                                    <Button x:Name="BtnInfoServiceAdmin" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Информационное обслуживание">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnReadersAdmin" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Читатели">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnLibraryFundAdmin" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Библиотечный фонд">
                                        <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnReportsAdmin" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Отчёты">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnRequestBookAdmin" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Подать заявку">
                                        <Path Data="M4 6h16v12H4V6zm2 2v2h12V8H6zm0 4v2h12v-2H6z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnRequestsManagementAdmin" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Управление заявками">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15h-4v-2h4v2zm0-4h-4v-2h4v2zm6 4h-4v-2h4v2zm0-4h-4v-2h4v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                </StackPanel>

                                <!-- Меню для Библиотекаря -->
                                <StackPanel x:Name="MenuLibrarian" Visibility="Collapsed">
                                    <Button x:Name="BtnInfoServiceLib" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Информационное обслуживание">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnReadersLib" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Читатели">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnLibraryFundLib" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Библиотечный фонд">
                                        <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnReportsLib" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Отчёты">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnRequestsManagementLib" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Управление заявками">
                                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15h-4v-2h4v2zm0-4h-4v-2h4v2zm6 4h-4v-2h4v2zm0-4h-4v-2h4v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnPcManagementLib" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Управление ПК">
                                        <Path Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnUsers" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Пользователи">
                                        <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V17h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-1 .05 1.16.84 2 1.87 2 3.45V17h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
      Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" 
      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                </StackPanel>

                               
                                <!-- Меню для Читателя -->
                                <StackPanel x:Name="MenuReader" Visibility="Collapsed">
                                    <Button x:Name="BtnRequestBookReader" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Подать заявку">
                                        <Path Data="M4 6h16v12H4V6zm2 2v2h12V8H6zm0 4v2h12v-2H6z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnMyRequestsReader" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Мои заявки">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                    <Button x:Name="BtnMyBooksReader" Style="{StaticResource MenuButtonStyle}" Click="MenuButton_Click" Tag="Мои книги">
                                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Separator Margin="12,16,12,16" Height="1" Background="{StaticResource BorderColor}"/>

                        <!-- Кнопка выхода из системы -->
                        <Button x:Name="BtnLogout"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="BtnLogout_Click"
                                Tag="Выход">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M10.09 15.59L11.5 17 16.5 12 11.5 7 10.09 8.41 12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                                      Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"
                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========== ОБЛАСТЬ ОСНОВНОГО КОНТЕНТА ========== -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <!-- Фрейм для загрузки страниц -->
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Margin="20"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"/>

            <!-- Оверлей загрузки (прогресс-бар) - поверх контента -->
            <Border x:Name="LoadingOverlay" 
                    Background="#CCFFFFFF" 
                    Visibility="Collapsed"
                    Panel.ZIndex="999">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryColor}"
                                CornerRadius="12"
                                Padding="30,25"
                                Effect="{StaticResource DropShadowEffect}">
                            <StackPanel>
                                <TextBlock x:Name="LoadingMessageText" 
                                           Text="Загрузка..." 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,15"/>
                                <ProgressBar Width="250" 
                                             Height="4" 
                                             IsIndeterminate="True"
                                             Foreground="White"
                                             Background="#40FFFFFF"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>