<Window x:Class="Diplom_Bibl.Controls.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CustomMessageBox" 
        Height="Auto" 
        Width="400"
        MinHeight="150"
        MaxWidth="600"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
         WindowStyle="None"
        Background="{StaticResource MenuBgColor}"
        FontFamily="Segoe UI">
    
    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Window">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource PrimaryColor}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Заголовок -->
                                <Border Grid.Row="0" 
                                        Background="{StaticResource PrimaryColor}"
                                        CornerRadius="8,8,0,0"
                                        Padding="12,8">
                                    <Grid>
                                        <TextBlock x:Name="TitleText"
                                                   Text="{TemplateBinding Title}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                        <Button Content="✕"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="White"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                Padding="8,4"
                                                Click="CloseButtonClick">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                                    VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                                
                                <!-- Контент -->
                                <Grid Grid.Row="1" Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Иконка -->
                                    <Image x:Name="MessageIcon"
                                           Grid.Column="0"
                                           Width="48"
                                           Height="48"
                                           Margin="0,0,16,0"
                                           VerticalAlignment="Top"/>
                                    
                                    <!-- Текст сообщения -->
                                    <TextBlock x:Name="MessageText"
                                               Grid.Column="1"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{StaticResource TextColor}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                
                                <!-- Кнопки -->
                                <Border Grid.Row="2"
                                        Padding="16"
                                        Background="{StaticResource LightGray}">
                                    <StackPanel x:Name="ButtonsPanel"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                />
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Style>
</Window>
