<Window x:Class="Diplom_Bibl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diplom_Bibl"
        mc:Ignorable="d"
        Title="Библиотечная система НМК" WindowState="Maximized" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0056B3"/>
        <SolidColorBrush x:Key="PrimaryLightColor" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007BFF"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="MenuBgColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MenuHoverColor" Color="#F0F8FF"/>
        <SolidColorBrush x:Key="MenuActiveColor" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <!-- Стиль для кнопок меню -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="icon" Content="{TemplateBinding Content}" />
                                <TextBlock x:Name="text" Text="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MenuHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource MenuActiveColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для активной кнопки -->
        <Style x:Key="ActiveMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Background" Value="{StaticResource MenuActiveColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <!-- Меню -->
            <ColumnDefinition Width="*"/>
            <!-- Контент -->
        </Grid.ColumnDefinitions>

        <!-- Левое меню -->
        <Border Grid.Column="0" Background="{StaticResource MenuBgColor}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <StackPanel>
                <!-- Заголовок меню -->
                <StackPanel Orientation="Horizontal" Margin="16,24,16,32">
                    <TextBlock Text="📚" FontSize="24" Margin="0,0,8,0"/>
                    <TextBlock Text="Библиотека НМК" 
                               FontSize="18" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Пункты меню -->
                <Button x:Name="BtnInfoService" 
                        Style="{StaticResource MenuButtonStyle}"
                        Tag="Информационное обслуживание"
                        Click="MenuButton_Click" Width="240" Height="58" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,4">
                   
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Button>

                <!--<Button x:Name="BtnReaders" 
                        Style="{StaticResource MenuButtonStyle}"
                        Tag="Читатели"
                        Click="MenuButton_Click">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Button>

                <Button x:Name="BtnLibraryFund" 
                        Style="{StaticResource MenuButtonStyle}"
                        Tag="Библиотечный фонд"
                        Click="MenuButton_Click">
                    <Path Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Button>

                <Button x:Name="BtnReports" 
                        Style="{StaticResource MenuButtonStyle}"
                        Tag="Отчёты"
                        Click="MenuButton_Click">
                    <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Button>-->

                <!-- Разделитель -->
                <Separator Margin="16,24" Height="1" Background="{StaticResource BorderColor}"/>

                <!-- Кнопка выхода --><!--
                <Button x:Name="BtnLogout"
                        Style="{StaticResource MenuButtonStyle}"
                        Tag="Выход"
                        Click="BtnLogout_Click">
                    <Path Data="M10.09 15.59L11.5 17 16.5 12 11.5 7 10.09 8.41 12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          Width="20" Height="20" Stretch="Uniform"/>
                </Button>-->
            </StackPanel>
        </Border>

        <!-- Контентная область -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <Frame x:Name="MainFrame"
                   NavigationUIVisibility="Hidden"
                   Margin="24"/>
        </Grid>
    </Grid>
</Window>

