<Page x:Class="Diplom_Bibl.Pages.AddSupplier"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      Title="Управление поставщиками" Loaded="Page_Loaded"
      Background="#F5F5F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление поставщиками" 
                   Style="{StaticResource SectionTitleStyle}"/>

        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Форма ввода -->
            <StackPanel Grid.Column="0" Width="400" Margin="15">
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Название поставщика *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbSupplierName" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="ИНН" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbINN" Style="{StaticResource InputFieldStyle}" MaxLength="12"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Телефон" Style="{StaticResource LabelStyle}"/>
                    <xctk:MaskedTextBox x:Name="TbPhone" 
                                        Mask="+7 (000) 000-00-00" 
                                        Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbEmail" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Адрес" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbAddress" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Комментарий" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TbComment" AcceptsReturn="True" Height="80" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnSaveNew" Content="Сохранить"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="BtnSaveNew_Click" Width="160" Margin="0,0,10,0"/>
                    <Button x:Name="BtnSaveChanges" Content="Сохранить изменения"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="BtnSaveChanges_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="BtnDelete" Content="Удалить"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="BtnDelete_Click" Visibility="Collapsed" Width="100"/>
                </StackPanel>
            </StackPanel>

            <!-- Список поставщиков -->
            <Grid Grid.Column="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox" Grid.Row="0" 
                         Style="{StaticResource InputFieldStyle}"
                         TextChanged="SearchBox_TextChanged"
                         Margin="0,0,0,10"
                         ToolTip="Поиск по названию"/>

                <DataGrid x:Name="LvSuppliers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          RowHeight="32" AlternatingRowBackground="{StaticResource LightGray}"
                          Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                          MouseDoubleClick="LvSuppliers_MouseDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PrimaryLightColor}"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="35"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding SupplierName}" Width="200"/>
                        <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="100"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="110"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Button Grid.Row="2" Content="← Закрыть" Style="{StaticResource PrimaryButtonStyle}"
                Background="{StaticResource LightGray}" Foreground="{StaticResource TextColor}"
                HorizontalAlignment="Center" Width="160" Click="ClosePage_Click" Margin="0,20,0,0"/>
    </Grid>
</Page>