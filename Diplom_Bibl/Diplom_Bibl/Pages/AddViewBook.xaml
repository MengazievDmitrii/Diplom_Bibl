<Page x:Class="Diplom_Bibl.Pages.AddViewBook"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Title="AddViewBook">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Заголовок -->
            <RowDefinition Height="*"/>   <!-- Основное содержимое -->
            <RowDefinition Height="Auto"/> <!-- Кнопка закрытия -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Добавление вида книги" 
                   Style="{StaticResource SectionTitleStyle}" 
                   Margin="0,0,0,15"/>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: ввод данных -->
            <StackPanel Grid.Column="0" Width="400" Margin="15">
                <StackPanel Margin="0,0,0,20">
                    <!-- Скрытый Label для ID (если понадобится) -->
                    <Label Name="ViewIDLabel" Visibility="Collapsed"/>
                    <TextBlock Text="Вид книги" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="View_Book_Tb" Style="{StaticResource InputFieldStyle}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SaveNewRecordButton" 
                            Content="Сохранить новый вид"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="SaveNewRecordButton_Click"
                            Margin="0,0,10,0" Width="264"/>

                    <Button x:Name="SaveChangesButton" 
                            Content="Сохранить изменения"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="SaveChangesButton_Click"
                            HorizontalAlignment="Left"
                            Margin="0,0,10,0" 
                            Visibility="Collapsed"/>

                    <Button x:Name="DeleteButton" 
                            Content="Удалить"
                            Style="{StaticResource DeleteButtonStyle}" 
                            Click="DeleteButton_Click"
                            HorizontalAlignment="Left"
                            Background="Red"    
                            Foreground="White"
                            Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>

            <!-- Правая панель: список + поиск -->
            <Grid Grid.Column="1" Width="400" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Поиск -->
                    <RowDefinition Height="*"/>   <!-- ListView -->
                </Grid.RowDefinitions>

                <!-- Поле поиска -->
                <Grid Grid.Row="0" Background="LightGray" Margin="0,0,0,5">
                    <TextBlock Text="Поиск" 
                               Style="{StaticResource LabelStyle}" 
                               Margin="10,4,270,2"/>
                    <TextBox x:Name="SearchBox"
                             Margin="60,0,124,0"
                             Padding="6,4"
                             VerticalAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             ToolTip="Введите название вида (например: Бумажный)"
                             Style="{StaticResource InputFieldStyle}" 
                             Height="30"/>
                </Grid>

                <!-- Список видов книг -->
                <ListView Grid.Row="1" 
                          x:Name="LvStatusBook"
                          BorderThickness="0,1,0,0" 
                          BorderBrush="Gray"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="LvStatusBook_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Вид книги" 
                                            Width="Auto" 
                                            DisplayMemberBinding="{Binding View_Book}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- Кнопка закрытия -->
        <Button Grid.Row="2" 
                x:Name="ClosePage" 
                Content="Закрыть страницу"
                Style="{StaticResource SaveButtonStyle}"
                HorizontalAlignment="Center" 
                Width="160" 
                Height="42"
                Click="ClosePage_Click"
                Margin="0,10,0,10"/>
    </Grid>
</Page>