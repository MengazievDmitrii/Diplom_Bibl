    <Grid Background="#F5F5F5">
        <Border 
        Width="356"
        Padding="30"
        Background="White"
        CornerRadius="12"
        Effect="{StaticResource DropShadowEffect}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center" Height="414">

            <!-- Логотип и заголовок -->
            <StackPanel Margin="0,4,-12,-20">
                <Image Source="C:\Users\menga\source\repos\Diplom_Bibl\Diplom_Bibl\Image\ЛОГОПНГ.png" Width="64" Height="64" Margin="0,0,0,20"/>
                <TextBlock Text="Библиотечная система НМК" FontSize="18" FontWeight="Bold" Foreground="#003366" TextAlignment="Center" Margin="0,0,0,20"/>

                <!-- Форма входа -->
                <StackPanel Margin="0,10,0,0" Height="228" Width="286">
                    <TextBlock Text="Вход в систему" FontSize="16" FontWeight="SemiBold" Foreground="#003366" TextAlignment="Center" Margin="0,0,0,20"/>

                    <Grid Width="278" Height="36" Margin="0,0,0,20">
                        <!-- Поле логина -->
                        <TextBox x:Name="LoginBox"
                            Style="{StaticResource TextBoxStyle}"
                            Margin="0"
                            Foreground="Black"
                            VerticalContentAlignment="Center" />
                        <TextBlock x:Name="LoginPlaceholder"
                          Text="Логин"
                          FontStyle="Italic"
                          Foreground="Gray"
                          VerticalAlignment="Center" 
                          Margin="10,0,30,0"
                          IsHitTestVisible="False"
                          Visibility="{Binding Text, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}, ElementName=LoginBox}"/>
                    </Grid>


                    <!-- Поле пароля -->

                    <Grid Width="278" Height="36" Margin="0,0,0,20">
                        <!-- PasswordBox (нижний слой) -->
                        <PasswordBox x:Name="PasswordBox"
                 Padding="8,0"
                 VerticalContentAlignment="Center"
                 BorderBrush="#CCCCCC"
                 BorderThickness="1"
                 Background="White"
                 Foreground="Black"
                 GotFocus="PasswordBox_GotFocus"
                 LostFocus="PasswordBox_LostFocus"
                 PasswordChanged="PasswordBox_PasswordChanged"/>
                        <TextBox x:Name="VisiblePasswordBox"
                      Padding="8,0" 
                      VerticalContentAlignment="Center"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1"
                      Background="White"
                      Foreground="Black"
                      Visibility="Collapsed"
                      Margin="0" />

                        <ToggleButton x:Name="TogglePasswordVisibility"
                              Width="33"
                              Height="27"
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Checked="TogglePasswordVisibility_Checked"
                              Unchecked="TogglePasswordVisibility_Unchecked"
                              Background="Transparent"
                              BorderBrush="Transparent"
                              Cursor="Hand">
                            <Path x:Name="EyeIcon"
              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-2.67 0-5.05-1.44-6.36-3.64L12 19l6.36-2.64C19.67 14.16 22 11.68 22 9c0-.66-.08-1.3-.22-1.91L12 4 2.22 7.09C2.08 7.7 2 8.34 2 9c0 2.68 2.32 5.16 5.64 6.36L12 18z"
              Fill="#999999"
              Width="18"
              Height="18" RenderTransformOrigin="0.5,0.5">
                            </Path>
                        </ToggleButton>

                        <!-- Placeholder (посередине, теперь должен быть между PasswordBox и ToggleButton, чтобы быть кликабельным) -->
                        <TextBlock x:Name="PasswordPlaceholder"
               Text="Пароль"
               Foreground="Gray"
               FontStyle="Italic"
               VerticalAlignment="Center"
               Margin="8,0,35,0"
               IsHitTestVisible="False"
               Visibility="Visible"/>
                    </Grid>
                    <!-- Кнопка входа -->
                    <Button Content="Войти" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10" Click="Button_Click" />

                    <!-- Ссылка "Забыли пароль?" -->
                    <TextBlock Text="Забыли пароль?" Foreground="#007BFF" TextAlignment="Center" Cursor="Hand"  Margin="0,10,0,0"/>
                    <!--MouseDown="ForgotPassword_Click"-->
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>



